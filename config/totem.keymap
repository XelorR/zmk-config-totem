//
//                                                        ▀▀▀▀▀     ▀▀▀▀▀          ▀▀█▀▀
//                                                        ▄▀▀▀▄  ▄  ▄▀▀▀▄  ▄  ▄▀▀▀▄  █  ▄▀▀▀▄
//                                                        █   █  █  █   █  █  █   █  █  █   █
//                                                         ▀▀▀   █   ▀▀▀   █   ▀▀▀   ▀   ▀▀▀
//                                                               █      ▄▄▄█▄▄▄    █   █  
//                                                               ▀      █  █  █     █▄█
//                                                             ▀▀▀▀▀    █  █  █      ▀
//                                                                      ▀  ▀  ▀
//
// ▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄

#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/ext_power.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

&mt {
    quick-tap-ms = <100>;
    global-quick-tap;
    flavor = "tap-preferred";
    tapping-term-ms = <170>;
};

/ {
    combos {
        compatible = "zmk,combos";

        un_tap {
            bindings = <&to 0>;
            key-positions = <0 9>;
            layers = <4>;
        };

        win_lg1 {
            bindings = <&cmd_space_lang1>;
            key-positions = <1 3>;
            layers = <0 2>;
        };

        win_lg2 {
            bindings = <&cmd_space_lang2>;
            key-positions = <6 8>;
            layers = <0 2>;
        };

        mac_lg1 {
            bindings = <&ctrl_space_lang1>;
            key-positions = <22 24>;
            layers = <0 2>;
        };

        mac_lg2 {
            bindings = <&ctrl_space_lang2>;
            key-positions = <27 29>;
            layers = <0 2>;
        };

        ckeckbox_combo {
            bindings = <&checkbox>;
            key-positions = <22 24>;
            layers = <9 10>;
        };

        para_combo {
            bindings = <&parathesis>;
            key-positions = <11 13>;
            layers = <9 10 13 14>;
        };

        arrow_combo {
            bindings = <&arrow>;
            key-positions = <1 3>;
            layers = <9 10>;
        };

        lg2_checkbox_combo {
            bindings = <&lg2_checkbox>;
            key-positions = <22 24>;
            layers = <13 14>;
        };

        lg2_arrow_combo {
            bindings = <&lg2_arrow>;
            key-positions = <1 3>;
            layers = <13 14>;
        };

        lg2_left_bracket_letter {
            bindings = <&kp LBKT>;
            key-positions = <6 7>;
            layers = <2>;
        };

        lg2_right_bracket_letter {
            bindings = <&kp RBKT>;
            key-positions = <7 8>;
            layers = <2>;
        };

        lg2_quote_letter {
            bindings = <&kp SQT>;
            key-positions = <2 1>;
            layers = <2>;
        };

        lg2_grave_letter {
            bindings = <&kp GRAVE>;
            key-positions = <2 3>;
            layers = <2>;
        };
    };

    macros {
        bt_clear_2: bt_clear_2 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&bt BT_SEL 2 &bt BT_CLR>;
            label = "BT_CLEAR_2";
        };

        bt_clear_3: bt_clear_3 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&bt BT_SEL 3 &bt BT_CLR>;
            label = "BT_CLEAR_3";
        };

        bt_clear_4: bt_clear_4 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&bt BT_SEL 4 &bt BT_CLR>;
            label = "BT_CLEAR_4";
        };

        bt_clear_0: bt_clear_0 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&bt BT_SEL 0 &bt BT_CLR>;
            label = "BT_CLEAR_0";
        };

        bt_clear_1: bt_clear_1 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&bt BT_SEL 1 &bt BT_CLR>;
            label = "BT_CLEAR_1";
        };

        cmd_space_lang1: cmd_space_lang1 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LG(SPACE) &to 0>;
            label = "CMD_SPACE_LANG1";
        };

        cmd_space_lang2: cmd_space_lang2 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LG(SPACE) &to 2>;
            label = "CMD_SPACE_LANG2";
        };

        ctrl_space_lang1: ctrl_space_lang1 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LC(SPACE) &to 0>;
            label = "CTRL_SPACE_LANG1";
        };

        ctrl_space_lang2: ctrl_space_lang2 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LC(SPACE) &to 2>;
            label = "CTRL_SPACE_LANG2";
        };

        checkbox: checkbox {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp HOME &kp MINUS &kp SPACE &kp LBKT &kp SPACE &kp RBKT &kp SPACE &kp END>;
            label = "CHECKBOX";
        };

        parathesis: parathesis {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LPAR &kp RPAR &kp LEFT>;
            label = "PARATHESIS";
        };

        arrow: arrow {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp EQUAL &kp GT>;
            label = "ARROW";
        };

        lg2_checkbox: ru_checkbox {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LG(SPACE) &checkbox &kp LG(SPACE)>;
            label = "RU_CHECKBOX";
        };

        lg2_arrow: lg2_arrow {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LG(SPACE) &arrow &kp LG(SPACE)>;
            label = "LG2_ARROW";
        };

        ml: ml {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings =
                <&macro_param_1to1 &key_on MACRO_PLACEHOLDER &layer_on 3>,
                <&macro_pause_for_release>,
                <&macro_param_1to1 &key_off MACRO_PLACEHOLDER &layer_off 3>;

            label = "ML";
            wait-ms = <0>;
            tap-ms = <0>;
        };

        lg1_symbol: lg1_symbol {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings = <&kp LG(SPACE) &macro_param_1to1 &ku MACRO_PLACEHOLDER &kp LG(SPACE)>;
            label = "LG1_SYMBOL";
        };

        ku: kp_unshift {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings = <&key_off RSHFT &macro_param_1to1 &kp MACRO_PLACEHOLDER>;
            label = "KP_UNSHIFT";
            wait-ms = <0>;
            tap-ms = <0>;
        };
    };

    behaviors {
        td_bootloader: td_bootloader {
            compatible = "zmk,behavior-tap-dance";
            label = "TD_BOOTLOADER";
            #binding-cells = <0>;
            bindings = <&none>, <&bootloader>;
        };

        bt_0: bt_0 {
            compatible = "zmk,behavior-mod-morph";
            label = "BT_0";
            bindings = <&bt BT_SEL 0>, <&bt_clear_0>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT)>;
        };

        bt_1: bt_1 {
            compatible = "zmk,behavior-mod-morph";
            label = "BT_1";
            bindings = <&bt BT_SEL 1>, <&bt_clear_1>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT)>;
        };

        bt_2: bt_2 {
            compatible = "zmk,behavior-mod-morph";
            label = "BT_2";
            bindings = <&bt BT_SEL 2>, <&bt_clear_2>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT)>;
        };

        bt_3: bt_3 {
            compatible = "zmk,behavior-mod-morph";
            label = "BT_3";
            bindings = <&bt BT_SEL 3>, <&bt_clear_3>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT)>;
        };

        bt_4: bt_4 {
            compatible = "zmk,behavior-mod-morph";
            label = "BT_4";
            bindings = <&bt BT_SEL 4>, <&bt_clear_4>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT)>;
        };

        u_out_tog: u_out_tog {
            compatible = "zmk,behavior-mod-morph";
            label = "U_OUT_TOG";
            bindings = <&out OUT_TOG>, <&out OUT_USB>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT)>;
        };

        u_ep_tog: u_ep_tog {
            compatible = "zmk,behavior-mod-morph";
            label = "U_EP_TOG";
            bindings = <&ext_power EP_TOG>, <&ext_power EP_OFF>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT)>;
        };

        u_caps_word: u_caps_word {
            compatible = "zmk,behavior-mod-morph";
            label = "U_CAPS_WORD";
            bindings = <&caps_word>, <&kp CAPS>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT)>;
        };

        to_extra: to_extra {
            compatible = "zmk,behavior-tap-dance";
            label = "TO_EXTRA";
            #binding-cells = <0>;
            bindings = <&none>, <&to 1>;
        };

        to_tap: to_tap {
            compatible = "zmk,behavior-tap-dance";
            label = "TO_TAP";
            #binding-cells = <0>;
            bindings = <&none>, <&to 4>;
        };

        to_base: to_base {
            compatible = "zmk,behavior-tap-dance";
            label = "TO_BASE";
            #binding-cells = <0>;
            bindings = <&none>, <&to 0>;
        };

        frz_nav: frz_nav {
            compatible = "zmk,behavior-tap-dance";
            label = "FRZ_NAV";
            #binding-cells = <0>;
            bindings = <&none>, <&tog 7>;
        };

        frz_mou: frz_mou {
            compatible = "zmk,behavior-tap-dance";
            label = "FRZ_MOU";
            #binding-cells = <0>;
            bindings = <&none>, <&tog 8>;
        };

        frz_med: frz_med {
            compatible = "zmk,behavior-tap-dance";
            label = "FRZ_MED";
            #binding-cells = <0>;
            bindings = <&none>, <&tog 15>;
        };

        frz_num: frz_num {
            compatible = "zmk,behavior-tap-dance";
            label = "FRZ_NUM";
            #binding-cells = <0>;
            bindings = <&none>, <&tog 9>;
        };

        frz_sym: frz_sym {
            compatible = "zmk,behavior-tap-dance";
            label = "FRZ_SYM";
            #binding-cells = <0>;
            bindings = <&none>, <&tog 10>;
        };

        frz_fun: frz_fun {
            compatible = "zmk,behavior-tap-dance";
            label = "FRZ_FUN";
            #binding-cells = <0>;
            bindings = <&none>, <&tog 16>;
        };

        to_gam: to_gam {
            compatible = "zmk,behavior-tap-dance";
            label = "TO_GAM";
            #binding-cells = <0>;
            bindings = <&none>, <&to 5>;
        };

        layer_on: layer_on {
            compatible = "zmk,behavior-toggle-layer";
            label = "LAYER_ON";
            #binding-cells = <1>;
        };

        layer_off: layer_off {
            compatible = "zmk,behavior-toggle-layer";
            label = "LAYER_OFF";
            #binding-cells = <1>;
            toggle-mode = "off";
        };

        key_on: key_on {
            compatible = "zmk,behavior-key-toggle";
            label = "KEY_ON";
            #binding-cells = <1>;
        };

        key_off: key_off {
            compatible = "zmk,behavior-key-toggle";
            label = "KEY_OFF";
            #binding-cells = <1>;
            toggle-mode = "off";
        };

        hrml: hrml {
            compatible = "zmk,behavior-hold-tap";
            label = "HRML";
            bindings = <&ml>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <170>;
            flavor = "tap-preferred";
            quick-tap-ms = <100>;
        };

        frz_num2: frz_num2 {
            compatible = "zmk,behavior-tap-dance";
            label = "FRZ_NUM2";
            #binding-cells = <0>;
            bindings = <&none>, <&tog 13>;
        };

        frz_sym2: frz_sym2 {
            compatible = "zmk,behavior-tap-dance";
            label = "FRZ_SYM2";
            #binding-cells = <0>;
            bindings = <&none>, <&tog 14>;
        };

        frz_nav2: frz_nav2 {
            compatible = "zmk,behavior-tap-dance";
            label = "FRZ_NAV2";
            #binding-cells = <0>;
            bindings = <&none>, <&tog 11>;
        };

        frz_mou2: frz_mou2 {
            compatible = "zmk,behavior-tap-dance";
            label = "FRZ_MOU2";
            #binding-cells = <0>;
            bindings = <&none>, <&tog 12>;
        };

        mu: mt_unshift {
            compatible = "zmk,behavior-hold-tap";
            label = "MT_UNSHIFT";
            bindings = <&kp>, <&ku>;

            #binding-cells = <2>;
            tapping-term-ms = <170>;
            quick-tap-ms = <100>;
            flavor = "tap-preferred";
        };

        lu: lt_unshift {
            compatible = "zmk,behavior-hold-tap";
            label = "LT_UNSHIFT";
            bindings = <&mo>, <&ku>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
        };

        u_left: u_left {
            compatible = "zmk,behavior-mod-morph";
            label = "U_LEFT";
            bindings = <&kp LEFT>, <&kp LEFT>;

            #binding-cells = <0>;
            mods = <(MOD_RSFT)>;
        };

        u_down: u_down {
            compatible = "zmk,behavior-mod-morph";
            label = "U_DOWN";
            bindings = <&kp DOWN>, <&kp DOWN>;

            #binding-cells = <0>;
            mods = <(MOD_RSFT)>;
        };

        u_up: u_up {
            compatible = "zmk,behavior-mod-morph";
            label = "U_UP";
            bindings = <&kp UP>, <&kp UP>;

            #binding-cells = <0>;
            mods = <(MOD_RSFT)>;
        };

        u_right: u_right {
            compatible = "zmk,behavior-mod-morph";
            label = "U_RIGHT";
            bindings = <&kp RIGHT>, <&kp RIGHT>;

            #binding-cells = <0>;
            mods = <(MOD_RSFT)>;
        };

        u_home: u_home {
            compatible = "zmk,behavior-mod-morph";
            label = "U_HOME";
            bindings = <&kp HOME>, <&kp HOME>;

            #binding-cells = <0>;
            mods = <(MOD_RSFT)>;
        };

        u_end: u_end {
            compatible = "zmk,behavior-mod-morph";
            label = "U_END";
            bindings = <&kp END>, <&kp END>;

            #binding-cells = <0>;
            mods = <(MOD_RSFT)>;
        };

        u_pgdn: u_pgdn {
            compatible = "zmk,behavior-mod-morph";
            label = "U_PGDN";
            bindings = <&kp PG_DN>, <&kp PG_DN>;

            #binding-cells = <0>;
            mods = <(MOD_RSFT)>;
        };

        u_pgup: u_pgup {
            compatible = "zmk,behavior-mod-morph";
            label = "U_PGUP";
            bindings = <&kp PG_UP>, <&kp PG_UP>;

            #binding-cells = <0>;
            mods = <(MOD_RSFT)>;
        };

        lg2_caps_word: lg2_caps_word {
            compatible = "zmk,behavior-mod-morph";
            label = "LG2_CAPS_WORD";
            bindings = <&key_on RSHFT>, <&kp CAPS>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT)>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base_layer {
            label = "BASE";
            bindings = <
           &kp Q       &kp W       &kp F        &kp P        &kp B         &kp J      &kp L        &kp U        &kp Y         &kp SQT
           &mt LGUI A  &mt LALT R  &mt LCTRL S  &mt LSHFT T  &kp G         &kp M      &mt LSHFT N  &mt LCTRL E  &mt LALT I    &mt LGUI O
&kp LSHFT  &lt 17 Z    &mt RALT X  &kp C        &kp D        &kp V         &kp K      &kp H        &kp COMMA    &mt RALT DOT  &lt 17 FSLH  &kp LSHFT
                                   &lt 16 DEL   &lt 9 BSPC   &lt 10 RET    &lt 8 TAB  &lt 7 SPACE  &lu 15 ESC
            >;
        };

        extra_layer {
            label = "EXTRA";
            bindings = <
        &kp Q       &kp W       &kp E        &kp R        &kp T     &kp Y   &kp U        &kp I        &kp O         &kp P
        &mt LGUI A  &mt LALT S  &mt LCTRL D  &mt LSHFT F  &kp G     &kp H   &mt LSHFT J  &mt LCTRL K  &mt LALT L    &mt LGUI SQT
&trans  &lt 17 Z    &mt RALT X  &kp C        &kp V        &kp B     &kp N   &kp M        &kp COMMA    &mt RALT DOT  &lt 17 FSLH   &trans
                                &trans       &trans       &trans    &trans  &trans       &trans
            >;
        };

        lang2_layer {
            label = "LANG2";
            bindings = <
        &kp Q         &kp W         &kp E          &kp R        &kp T         &kp Y       &kp U         &kp I          &kp O           &kp P
        &hrml LGUI A  &hrml LALT S  &hrml LCTRL D  &mt LSHFT F  &kp G         &kp H       &mt LSHFT J   &hrml LCTRL K  &hrml LALT L    &hrml LGUI SEMI
&trans  &lt 17 Z      &hrml RALT X  &kp C          &kp V        &kp B         &kp N       &kp M         &kp COMMA      &hrml RALT DOT  &lu 17 FSLH      &trans
                                    &trans         &lt 13 BSPC  &lu 14 RET    &lu 12 TAB  &lu 11 SPACE  &trans
            >;
        };

        shortcut_layer {
            label = "SHORTCUT";
            bindings = <
        &kp Q       &kp W       &kp F        &kp P        &kp B     &kp J   &kp L        &kp U        &kp Y         &kp SQT
        &mt LGUI A  &mt LALT R  &mt LCTRL S  &mt LSHFT T  &kp G     &kp M   &mt LSHFT N  &mt LCTRL E  &mt LALT I    &mt LGUI O
&trans  &lt 17 Z    &mt RALT X  &kp C        &kp D        &kp V     &kp K   &kp H        &kp COMMA    &mt RALT DOT  &lt 17 FSLH  &trans
                                &trans       &trans       &trans    &trans  &trans       &trans
            >;
        };

        tap_layer {
            label = "TAP";
            bindings = <
           &kp Q  &kp W  &kp F    &kp P     &kp B        &kp J    &kp L      &kp U      &kp Y    &kp APOS
           &kp A  &kp R  &kp S    &kp T     &kp G        &kp M    &kp N      &kp E      &kp I    &kp O
&kp LSHFT  &kp Z  &kp X  &kp C    &kp D     &kp V        &kp K    &kp H      &kp COMMA  &kp DOT  &kp FSLH  &kp LSHFT
                         &kp DEL  &kp BSPC  &kp ENTER    &kp TAB  &kp SPACE  &kp ESC
            >;
        };

        gaming_layer {
            bindings = <
          &kp TAB    &kp Q  &kp X     &kp E      &kp R    &trans      &trans     &trans    &trans     &kp TAB
          &kp LSHFT  &kp A  &kp W     &kp D      &kp F    &trans      &kp LEFT   &kp UP    &kp RIGHT  &kp RSHFT
&kp CAPS  &kp LCTRL  &kp Z  &kp S     &kp C      &kp B    &trans      &trans     &kp DOWN  &trans     &kp RCTRL  &trans
                            &kp LALT  &kp SPACE  &mo 6    &lt 16 RET  &kp SPACE  &mo 15
            >;

            label = "GAM";
        };

        gaming_fn {
            bindings = <
       &kp ESC  &kp N7  &kp N8   &kp N9  &kp T     &kp Y  &kp U      &kp I      &kp O    &kp P
       &kp I    &kp N4  &kp N5   &kp N6  &kp G     &kp H  &kp J      &kp K      &kp L    &kp SEMI
&kp J  &kp M    &kp N1  &kp N2   &kp N3  &kp B     &kp N  &kp M      &kp COMMA  &kp DOT  &kp FSLH  &trans
                        &kp RET  &kp N0  &trans    &to 0  &kp PSCRN  &trans
            >;

            label = "GAM_FN";
        };

        navi {
            bindings = <
        &kp HOME   &kp PG_DN  &kp PG_UP    &kp END      &kp INS         &none    &to_base   &to_extra  &to_tap   &td_bootloader
        &kp LEFT   &kp DOWN   &kp UP       &kp RIGHT    &u_caps_word    &to_gam  &kp LSHFT  &kp LCTRL  &kp LALT  &kp LGUI
&trans  &kp LC(Z)  &kp LC(X)  &kp LC(INS)  &kp LS(INS)  &kp LC(Y)       &none    &frz_nav   &frz_num   &kp RALT  &none           &trans
                              &kp DEL      &kp BSPC     &kp ENTER       &kp TAB  &kp SPACE  &kp ESC
            >;

            label = "NAVI";
        };

        mouse {
            bindings = <
        &msc SCRL_LEFT  &msc SCRL_DOWN  &msc SCRL_UP  &msc SCRL_RIGHT  &none        &none    &to_base   &to_extra  &to_tap   &td_bootloader
        &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_UP  &mmv MOVE_RIGHT  &none        &to_gam  &kp LSHFT  &kp LCTRL  &kp LALT  &kp LGUI
&trans  &kp LC(Z)       &kp LC(X)       &kp LC(INS)   &kp LS(INS)      &kp LC(Y)    &none    &frz_mou   &frz_sym   &kp RALT  &none           &trans
                                        &mkp MB3      &mkp MB1         &mkp MB2     &kp TAB  &kp SPACE  &kp ESC
            >;

            label = "MOUSE";
        };

        num_base {
            bindings = <
        &td_bootloader  &to_tap   &to_extra  &to_base   &none        &kp LBKT   &kp N7  &kp N8   &kp N9  &kp RBKT
        &kp LGUI        &kp LALT  &kp LCTRL  &kp LSHFT  &to_gam      &kp EQUAL  &kp N4  &kp N5   &kp N6  &kp SEMI
&trans  &none           &kp RALT  &frz_nav   &frz_num   &none        &kp BSLH   &kp N1  &kp N2   &kp N3  &kp GRAVE  &trans
                                  &kp DEL    &kp BSPC   &kp ENTER    &kp MINUS  &kp N0  &kp DOT
            >;

            label = "NUM_BASE";
        };

        sym_base {
            bindings = <
        &td_bootloader  &to_tap   &to_extra  &to_base   &none        &kp LBRC   &kp AMPS  &kp STAR   &kp LPAR   &kp RBRC
        &kp LGUI        &kp LALT  &kp LCTRL  &kp LSHFT  &to_gam      &kp PLUS   &kp DLLR  &kp PRCNT  &kp CARET  &kp COLON
&trans  &none           &kp RALT  &frz_mou   &frz_sym   &none        &kp PIPE   &kp EXCL  &kp AT     &kp HASH   &kp TILDE  &trans
                                  &kp DEL    &kp BSPC   &kp ENTER    &kp UNDER  &kp LPAR  &kp RPAR
            >;

            label = "SYM_BASE";
        };

        navi_lang2 {
            label = "NAVI_LANG2";
            bindings = <
        &u_home    &u_pgdn    &u_pgup      &u_end       &ku INS           &none    &to_base   &to_extra  &to_tap   &td_bootloader
        &u_left    &u_down    &u_up        &u_right     &lg2_caps_word    &to_gam  &kp LSHFT  &kp LCTRL  &kp LALT  &kp LGUI
&trans  &ku LC(Z)  &ku LC(X)  &ku LC(INS)  &ku LS(INS)  &ku LC(Y)         &none    &frz_nav2  &frz_num2  &kp RALT  &none           &trans
                              &kp DEL      &kp BSPC     &ku RET           &ku TAB  &ku SPACE  &ku ESC
            >;
        };

        mouse_lang2 {
            label = "MOUSE_LANG2";
            bindings = <
        &msc SCRL_LEFT  &msc SCRL_DOWN  &msc SCRL_UP  &msc SCRL_RIGHT  &none        &none    &to_base   &to_extra  &to_tap   &td_bootloader
        &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_UP  &mmv MOVE_RIGHT  &none        &to_gam  &kp LSHFT  &kp LCTRL  &kp LALT  &kp LGUI
&trans  &kp LC(Z)       &kp LC(X)       &kp LC(INS)   &kp LS(INS)      &kp LC(Y)    &none    &frz_mou2  &frz_sym2  &kp RALT  &none           &trans
                                        &mkp MB3      &mkp MB1         &mkp MB2     &kp TAB  &kp SPACE  &kp ESC
            >;
        };

        num_lang2 {
            bindings = <
        &td_bootloader  &to_tap   &to_extra  &to_base   &none        &lg1_symbol LBKT  &ku N7  &ku N8    &ku N9  &lg1_symbol RBKT
        &kp LGUI        &kp LALT  &kp LCTRL  &kp LSHFT  &to_gam      &ku EQUAL         &ku N4  &ku N5    &ku N6  &ku DLLR
&trans  &none           &kp RALT  &frz_nav2  &frz_num2  &none        &ku BSLH          &ku N1  &ku N2    &ku N3  &lg1_symbol GRAVE  &trans
                                  &kp DEL    &kp BSPC   &ku ENTER    &ku MINUS         &ku N0  &ku FSLH
            >;

            label = "NUM_LANG2";
        };

        sym_lang2 {
            bindings = <
        &td_bootloader  &to_tap   &to_extra  &to_base   &none        &lg1_symbol LBRC  &ku AMPS          &ku STAR   &ku LPAR           &lg1_symbol RBRC
        &kp LGUI        &kp LALT  &kp LCTRL  &kp LSHFT  &to_gam      &ku PLUS          &lg1_symbol DLLR  &ku PRCNT  &lg1_symbol CARET  &ku CARET
&trans  &none           &kp RALT  &frz_mou2  &frz_sym2  &none        &ku PIPE          &ku EXCL          &ku AT     &lg1_symbol HASH   &lg1_symbol TILDE  &trans
                                  &kp DEL    &kp BSPC   &ku ENTER    &ku UNDER         &ku LPAR          &ku RPAR
            >;

            label = "SYM_LANG2";
        };

        media {
            bindings = <
       &none       &none         &out OUT_USB  &out OUT_BLE  &bt BT_CLR_ALL    &none      &to_base   &to_extra  &to_tap   &td_bootloader
       &kp C_PREV  &kp C_VOL_DN  &kp C_VOL_UP  &kp C_NEXT    &u_ep_tog         &u_ep_tog  &kp LSHFT  &kp LCTRL  &kp LALT  &kp LGUI
&bt_4  &bt_3       &bt_2         &bt_1         &bt_0         &u_out_tog        &none      &frz_med   &frz_fun   &kp RALT  &none           &trans
                                 &kp K_MUTE    &kp C_PP      &kp C_STOP        &kp TAB    &kp SPACE  &kp ESC
            >;

            label = "MEDIA";
        };

        fun {
            bindings = <
        &kp F12  &kp F7  &kp F8     &kp F9     &kp PSCRN          &none      &to_base   &to_extra  &to_tap   &td_bootloader
        &kp F11  &kp F4  &kp F5     &kp F6     &kp SCROLLLOCK     &to_gam    &kp LSHFT  &kp LCTRL  &kp LALT  &kp LGUI
&trans  &kp F10  &kp F1  &kp F2     &kp F3     &kp PAUSE_BREAK    &none      &frz_fun   &frz_med   &kp RALT  &none           &trans
                         &kp K_APP  &kp SPACE  &kp TAB            &kp ENTER  &kp BSPC   &kp DEL
            >;

            label = "FUN";
        };

        button {
            bindings = <
        &kp LC(Z)  &kp LC(X)  &kp LC(INS)  &kp LS(INS)  &kp LC(Y)    &kp LC(Y)  &kp LS(INS)  &kp LC(INS)  &kp LC(X)  &kp LC(Z)
        &kp LGUI   &kp LALT   &kp LCTRL    &kp LSHFT    &trans       &trans     &kp LSHFT    &kp LCTRL    &kp LALT   &kp LGUI
&trans  &kp LC(Z)  &kp LC(X)  &kp LC(INS)  &kp LS(INS)  &kp LC(Y)    &kp LC(Y)  &kp LS(INS)  &kp LC(INS)  &kp LC(X)  &kp LC(Z)  &trans
                              &mkp MCLK    &mkp LCLK    &mkp RCLK    &mkp RCLK  &mkp LCLK    &mkp MCLK
            >;

            label = "BUTTON";
        };
    };
};
