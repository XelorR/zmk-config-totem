//
//                                                        ▀▀▀▀▀     ▀▀▀▀▀          ▀▀█▀▀
//                                                        ▄▀▀▀▄  ▄  ▄▀▀▀▄  ▄  ▄▀▀▀▄  █  ▄▀▀▀▄
//                                                        █   █  █  █   █  █  █   █  █  █   █
//                                                         ▀▀▀   █   ▀▀▀   █   ▀▀▀   ▀   ▀▀▀
//                                                               █      ▄▄▄█▄▄▄    █   █  
//                                                               ▀      █  █  █     █▄█
//                                                             ▀▀▀▀▀    █  █  █      ▀
//                                                                      ▀  ▀  ▀
//
// ▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄

#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/ext_power.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

&mt {
    quick-tap-ms = <100>;
    global-quick-tap;
    flavor = "tap-preferred";
    tapping-term-ms = <170>;
};

/ {
    combos {
        compatible = "zmk,combos";

        un_tap {
            bindings = <&to 0>;
            key-positions = <0 9>;
        };

        win_lg1 {
            bindings = <&cmd_space_lang1>;
            key-positions = <1 3>;
            layers = <0>;
        };

        win_lg2 {
            bindings = <&cmd_space_lang2>;
            key-positions = <6 8>;
            layers = <0>;
        };

        mac_lg1 {
            bindings = <&ctrl_space_lang1>;
            key-positions = <22 24>;
            layers = <0>;
        };

        mac_lg2 {
            bindings = <&ctrl_space_lang2>;
            key-positions = <27 29>;
            layers = <0>;
        };

        lg2_left_bracket_letter {
            bindings = <&kp LBKT>;
            key-positions = <6 7>;
        };

        lg2_right_bracket_letter {
            bindings = <&kp RBKT>;
            key-positions = <7 8>;
        };

        lg2_quote_letter {
            bindings = <&kp SQT>;
            key-positions = <2 1>;
        };

        lg2_grave_letter {
            bindings = <&kp GRAVE>;
            key-positions = <2 3>;
        };
    };

    macros {
        cmd_space_lang1: cmd_space_lang1 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LG(SPACE) &to 0>;
            label = "CMD_SPACE_LANG1";
        };

        cmd_space_lang2: cmd_space_lang2 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LG(SPACE) &to 0>;
            label = "CMD_SPACE_LANG2";
        };

        ctrl_space_lang1: ctrl_space_lang1 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LC(SPACE) &to 0>;
            label = "CTRL_SPACE_LANG1";
        };

        ctrl_space_lang2: ctrl_space_lang2 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LC(SPACE) &to 0>;
            label = "CTRL_SPACE_LANG2";
        };

        bt_clear_2: bt_clear_2 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&bt BT_SEL 2 &bt BT_CLR>;
            label = "BT_CLEAR_2";
        };

        bt_clear_3: bt_clear_3 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&bt BT_SEL 3 &bt BT_CLR>;
            label = "BT_CLEAR_3";
        };

        bt_clear_4: bt_clear_4 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&bt BT_SEL 4 &bt BT_CLR>;
            label = "BT_CLEAR_4";
        };

        bt_clear_0: bt_clear_0 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&bt BT_SEL 0 &bt BT_CLR>;
            label = "BT_CLEAR_0";
        };

        bt_clear_1: bt_clear_1 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&bt BT_SEL 1 &bt BT_CLR>;
            label = "BT_CLEAR_1";
        };

        ml: ml {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings =
                <&macro_param_1to1 &key_on MACRO_PLACEHOLDER &layer_on 0>,
                <&macro_pause_for_release>,
                <&macro_param_1to1 &key_off MACRO_PLACEHOLDER &layer_off 0>;

            label = "ML";
            wait-ms = <0>;
            tap-ms = <0>;
        };

        ku: kp_unshift {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings = <&key_off RSHFT &macro_param_1to1 &kp MACRO_PLACEHOLDER>;
            label = "KP_UNSHIFT";
            wait-ms = <0>;
            tap-ms = <0>;
        };
    };

    behaviors {
        mu: mt_unshift {
            compatible = "zmk,behavior-hold-tap";
            label = "MT_UNSHIFT";
            bindings = <&kp>, <&ku>;

            #binding-cells = <2>;
            tapping-term-ms = <170>;
            quick-tap-ms = <100>;
            flavor = "tap-preferred";
        };

        lu: lt_unshift {
            compatible = "zmk,behavior-hold-tap";
            label = "LT_UNSHIFT";
            bindings = <&mo>, <&ku>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
        };

        td_bootloader: td_bootloader {
            compatible = "zmk,behavior-tap-dance";
            label = "TD_BOOTLOADER";
            #binding-cells = <0>;
            bindings = <&none>, <&bootloader>;
        };

        bt_0: bt_0 {
            compatible = "zmk,behavior-mod-morph";
            label = "BT_0";
            bindings = <&bt BT_SEL 0>, <&bt_clear_0>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT)>;
        };

        bt_1: bt_1 {
            compatible = "zmk,behavior-mod-morph";
            label = "BT_1";
            bindings = <&bt BT_SEL 1>, <&bt_clear_1>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT)>;
        };

        bt_2: bt_2 {
            compatible = "zmk,behavior-mod-morph";
            label = "BT_2";
            bindings = <&bt BT_SEL 2>, <&bt_clear_2>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT)>;
        };

        bt_3: bt_3 {
            compatible = "zmk,behavior-mod-morph";
            label = "BT_3";
            bindings = <&bt BT_SEL 3>, <&bt_clear_3>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT)>;
        };

        bt_4: bt_4 {
            compatible = "zmk,behavior-mod-morph";
            label = "BT_4";
            bindings = <&bt BT_SEL 4>, <&bt_clear_4>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT)>;
        };

        u_out_tog: u_out_tog {
            compatible = "zmk,behavior-mod-morph";
            label = "U_OUT_TOG";
            bindings = <&out OUT_TOG>, <&out OUT_USB>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT)>;
        };

        u_ep_tog: u_ep_tog {
            compatible = "zmk,behavior-mod-morph";
            label = "U_EP_TOG";
            bindings = <&ext_power EP_TOG>, <&ext_power EP_OFF>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT)>;
        };

        u_caps_word: u_caps_word {
            compatible = "zmk,behavior-mod-morph";
            label = "U_CAPS_WORD";
            bindings = <&caps_word>, <&kp CAPS>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT)>;
        };

        lg2_caps_word: lg2_caps_word {
            compatible = "zmk,behavior-mod-morph";
            label = "LG2_CAPS_WORD";
            bindings = <&key_on RSHFT>, <&kp CAPS>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT)>;
        };

        to_extra: to_extra {
            compatible = "zmk,behavior-tap-dance";
            label = "TO_EXTRA";
            #binding-cells = <0>;
            bindings = <&none>, <&to 0>;
        };

        to_tap: to_tap {
            compatible = "zmk,behavior-tap-dance";
            label = "TO_TAP";
            #binding-cells = <0>;
            bindings = <&none>, <&to 0>;
        };

        to_base: to_base {
            compatible = "zmk,behavior-tap-dance";
            label = "TO_BASE";
            #binding-cells = <0>;
            bindings = <&none>, <&to 0>;
        };

        to_gam: to_gam {
            compatible = "zmk,behavior-tap-dance";
            label = "TO_GAM";
            #binding-cells = <0>;
            bindings = <&none>, <&to 1>;
        };

        layer_on: layer_on {
            compatible = "zmk,behavior-toggle-layer";
            label = "LAYER_ON";
            #binding-cells = <1>;
        };

        layer_off: layer_off {
            compatible = "zmk,behavior-toggle-layer";
            label = "LAYER_OFF";
            #binding-cells = <1>;
            toggle-mode = "off";
        };

        key_on: key_on {
            compatible = "zmk,behavior-key-toggle";
            label = "KEY_ON";
            #binding-cells = <1>;
        };

        key_off: key_off {
            compatible = "zmk,behavior-key-toggle";
            label = "KEY_OFF";
            #binding-cells = <1>;
            toggle-mode = "off";
        };

        hrml: hrml {
            compatible = "zmk,behavior-hold-tap";
            label = "HRML";
            bindings = <&ml>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <170>;
            flavor = "tap-preferred";
            quick-tap-ms = <100>;
        };

        frz_nav: frz_nav {
            compatible = "zmk,behavior-tap-dance";
            label = "FRZ_NAV";
            #binding-cells = <0>;
            bindings = <&none>, <&tog 3>;
        };

        frz_mou: frz_mou {
            compatible = "zmk,behavior-tap-dance";
            label = "FRZ_MOU";
            #binding-cells = <0>;
            bindings = <&none>, <&tog 4>;
        };

        frz_med: frz_med {
            compatible = "zmk,behavior-tap-dance";
            label = "FRZ_MED";
            #binding-cells = <0>;
            bindings = <&none>, <&tog 7>;
        };

        frz_num: frz_num {
            compatible = "zmk,behavior-tap-dance";
            label = "FRZ_NUM";
            #binding-cells = <0>;
            bindings = <&none>, <&tog 5>;
        };

        frz_sym: frz_sym {
            compatible = "zmk,behavior-tap-dance";
            label = "FRZ_SYM";
            #binding-cells = <0>;
            bindings = <&none>, <&tog 6>;
        };

        frz_fun: frz_fun {
            compatible = "zmk,behavior-tap-dance";
            label = "FRZ_FUN";
            #binding-cells = <0>;
            bindings = <&none>, <&tog 8>;
        };

        frz_num2: frz_num2 {
            compatible = "zmk,behavior-tap-dance";
            label = "FRZ_NUM2";
            #binding-cells = <0>;
            bindings = <&none>, <&tog 0>;
        };

        frz_sym2: frz_sym2 {
            compatible = "zmk,behavior-tap-dance";
            label = "FRZ_SYM2";
            #binding-cells = <0>;
            bindings = <&none>, <&tog 0>;
        };

        frz_nav2: frz_nav2 {
            compatible = "zmk,behavior-tap-dance";
            label = "FRZ_NAV2";
            #binding-cells = <0>;
            bindings = <&none>, <&tog 0>;
        };

        frz_mou2: frz_mou2 {
            compatible = "zmk,behavior-tap-dance";
            label = "FRZ_MOU2";
            #binding-cells = <0>;
            bindings = <&none>, <&tog 0>;
        };

        u_left: u_left {
            compatible = "zmk,behavior-mod-morph";
            label = "U_LEFT";
            bindings = <&kp LEFT>, <&kp LEFT>;

            #binding-cells = <0>;
            mods = <(MOD_RSFT)>;
        };

        u_down: u_down {
            compatible = "zmk,behavior-mod-morph";
            label = "U_DOWN";
            bindings = <&kp DOWN>, <&kp DOWN>;

            #binding-cells = <0>;
            mods = <(MOD_RSFT)>;
        };

        u_up: u_up {
            compatible = "zmk,behavior-mod-morph";
            label = "U_UP";
            bindings = <&kp UP>, <&kp UP>;

            #binding-cells = <0>;
            mods = <(MOD_RSFT)>;
        };

        u_right: u_right {
            compatible = "zmk,behavior-mod-morph";
            label = "U_RIGHT";
            bindings = <&kp RIGHT>, <&kp RIGHT>;

            #binding-cells = <0>;
            mods = <(MOD_RSFT)>;
        };

        u_home: u_home {
            compatible = "zmk,behavior-mod-morph";
            label = "U_HOME";
            bindings = <&kp HOME>, <&kp HOME>;

            #binding-cells = <0>;
            mods = <(MOD_RSFT)>;
        };

        u_end: u_end {
            compatible = "zmk,behavior-mod-morph";
            label = "U_END";
            bindings = <&kp END>, <&kp END>;

            #binding-cells = <0>;
            mods = <(MOD_RSFT)>;
        };

        u_pgdn: u_pgdn {
            compatible = "zmk,behavior-mod-morph";
            label = "U_PGDN";
            bindings = <&kp PG_DN>, <&kp PG_DN>;

            #binding-cells = <0>;
            mods = <(MOD_RSFT)>;
        };

        u_pgup: u_pgup {
            compatible = "zmk,behavior-mod-morph";
            label = "U_PGUP";
            bindings = <&kp PG_UP>, <&kp PG_UP>;

            #binding-cells = <0>;
            mods = <(MOD_RSFT)>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base_layer {
            label = "BASE";
            bindings = <
           &kp Q  &kp W  &kp E      &kp R      &kp T    &kp Y  &kp U  &kp I      &kp O      &kp P
           &kp A  &kp S  &kp D      &kp F      &kp G    &kp H  &kp J  &kp K      &kp L      &kp SEMI
&kp GRAVE  &kp Z  &kp X  &kp C      &kp V      &kp B    &kp N  &kp M  &kp COMMA  &kp COMMA  &kp FSLH  &kp SQT
                         &kp LSHFT  &kp SPACE  &mo 3    &mo 6  &mo 5  &kp LSHFT
            >;
        };

        gaming_layer {
            bindings = <
          &kp TAB    &kp Q  &kp X     &kp E      &kp R    &trans     &trans     &trans    &trans     &kp TAB
          &kp LSHFT  &kp A  &kp W     &kp D      &kp F    &trans     &kp LEFT   &kp UP    &kp RIGHT  &kp RSHFT
&kp CAPS  &kp LCTRL  &kp Z  &kp S     &kp C      &kp B    &trans     &trans     &kp DOWN  &trans     &kp RCTRL  &trans
                            &kp LALT  &kp SPACE  &mo 2    &lt 7 RET  &kp SPACE  &mo 8
            >;

            label = "GAM";
        };

        gaming_fn {
            bindings = <
       &kp ESC  &kp N7  &kp N8   &kp N9  &kp T     &kp Y  &kp U      &kp I      &kp O    &kp P
       &kp I    &kp N4  &kp N5   &kp N6  &kp G     &kp H  &kp J      &kp K      &kp L    &kp SEMI
&kp J  &kp M    &kp N1  &kp N2   &kp N3  &kp B     &kp N  &kp M      &kp COMMA  &kp DOT  &kp FSLH  &kp SQT
                        &kp RET  &kp N0  &trans    &to 0  &kp PSCRN  &mo 8
            >;

            label = "GAM_FN";
        };

        navi {
            bindings = <
        &kp DEL   &trans     &trans       &kp LG(TAB)  &kp ESC    &kp ESC  &kp HOME  &kp PG_DN         &kp PG_UP         &kp END
        &sk LGUI  &sk LALT   &kp LCTRL    &sk LSHFT    &kp RET    &kp RET  &kp LEFT  &kp DOWN          &kp UP            &kp RIGHT
&trans  &to_gam   &kp LC(X)  &kp LC(INS)  &kp LS(INS)  &kp TAB    &kp TAB  &kp BSPC  &cmd_space_lang1  &cmd_space_lang2  &kp DEL    &trans
                             &trans       &mo 4        &trans     &trans   &trans    &trans
            >;

            label = "NAVI";
        };

        mouse {
            bindings = <
        &td_bootloader  &to_tap    &to_extra    &to_base     &none     &none      &msc SCRL_LEFT  &msc SCRL_DOWN    &msc SCRL_UP      &msc SCRL_RIGHT
        &sk LGUI        &sk LALT   &sk LCTRL    &sk LSHFT    &none     &none      &mmv MOVE_LEFT  &mmv MOVE_DOWN    &mmv MOVE_UP      &mmv MOVE_RIGHT
&trans  &to_gam         &kp LC(X)  &kp LC(INS)  &kp LS(INS)  &none     &none      &kp BSPC        &cmd_space_lang1  &cmd_space_lang2  &kp DEL          &trans
                                   &trans       &trans       &trans    &mkp RCLK  &mkp LCLK       &mkp MCLK
            >;

            label = "MOUSE";
        };

        num_base {
            bindings = <
          &kp LBKT   &kp N7  &kp N8   &kp N9  &kp RBKT     &none      &to_base   &to_extra  &to_tap   &td_bootloader
          &kp SEMI   &kp N4  &kp N5   &kp N6  &kp EQUAL    &to_gam    &kp LSHFT  &kp LCTRL  &kp LALT  &kp LGUI
&kp NUBS  &kp GRAVE  &kp N1  &kp N2   &kp N3  &kp BSLH     &none      &frz_num   &frz_nav   &kp RALT  &none           &trans
                             &kp DOT  &kp N0  &kp MINUS    &kp ENTER  &kp BSPC   &kp DEL
            >;

            label = "NUM_BASE";
        };

        sym_base {
            bindings = <
              &kp LEFT_BRACE  &kp AMPS  &kp STAR   &kp LPAR   &kp RBRC     &none      &to_base   &to_extra  &to_tap   &td_bootloader
              &kp COLON       &kp DLLR  &kp PRCNT  &kp CARET  &kp PLUS     &to_gam    &kp LSHFT  &kp LCTRL  &kp LALT  &kp LGUI
&kp LS(NUBS)  &kp TILDE       &kp EXCL  &kp AT     &kp HASH   &kp PIPE     &none      &frz_sym   &frz_mou   &kp RALT  &none           &trans
                                        &kp LPAR   &kp RPAR   &kp UNDER    &kp ENTER  &kp BSPC   &kp DEL
            >;

            label = "SYM_BASE";
        };

        media {
            bindings = <
        &td_bootloader  &to_tap   &to_extra  &to_base   &none      &bt BT_CLR_ALL  &out OUT_BLE  &out OUT_USB  &none         &none
        &kp LGUI        &kp LALT  &kp LCTRL  &kp LSHFT  &to_gam    &u_ep_tog       &kp C_PREV    &kp C_VOL_DN  &kp C_VOL_UP  &kp C_NEXT
&trans  &none           &kp RALT  &frz_fun   &frz_med   &none      &u_out_tog      &bt_0         &bt_1         &bt_2         &bt_3       &bt_4
                                  &kp ESC    &kp SPACE  &kp TAB    &kp C_STOP      &kp C_PP      &kp K_MUTE
            >;

            label = "MEDIA";
        };

        fun {
            bindings = <
        &kp F12  &kp F7  &kp F8  &kp F9  &kp LG(L)          &kp SCROLLLOCK  &kp C_VOL_DN  &kp K_MUTE  &kp C_VOL_UP  &td_bootloader
        &kp F11  &kp F4  &kp F5  &kp F6  &kp PSCRN          &u_caps_word    &sk LSHFT     &sk LCTRL   &sk LALT      &sk LGUI
&trans  &kp F10  &kp F1  &kp F2  &kp F3  &kp LC(LS(ESC))    &kp K_APP       &kp C_PREV    &kp C_PP    &kp C_NEXT    &kp PAUSE_BREAK  &trans
                         &trans  &trans  &trans             &trans          &trans        &trans
            >;

            label = "FUN";
        };
    };
};
