//
//                                                        ▀▀▀▀▀     ▀▀▀▀▀          ▀▀█▀▀
//                                                        ▄▀▀▀▄  ▄  ▄▀▀▀▄  ▄  ▄▀▀▀▄  █  ▄▀▀▀▄
//                                                        █   █  █  █   █  █  █   █  █  █   █
//                                                         ▀▀▀   █   ▀▀▀   █   ▀▀▀   ▀   ▀▀▀
//                                                               █      ▄▄▄█▄▄▄    █   █  
//                                                               ▀      █  █  █     █▄█
//                                                             ▀▀▀▀▀    █  █  █      ▀
//                                                                      ▀  ▀  ▀
//
// ▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄

#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

&mt {
    quick-tap-ms = <100>;
    global-quick-tap;
    flavor = "tap-preferred";
    tapping-term-ms = <170>;
};

/ {
    combos {
        compatible = "zmk,combos";

        un_tap {
            bindings = <&to 0>;
            key-positions = <0 9>;
            layers = <4>;
        };

        win_lg1 {
            bindings = <&cmd_space_lang1>;
            key-positions = <1 3>;
            layers = <0 2>;
        };

        win_lg2 {
            bindings = <&cmd_space_lang2>;
            key-positions = <6 8>;
            layers = <0 2>;
        };

        mac_lg1 {
            bindings = <&ctrl_space_lang1>;
            key-positions = <22 24>;
            layers = <0 2>;
        };

        mac_lg2 {
            bindings = <&ctrl_space_lang2>;
            key-positions = <27 29>;
            layers = <0 2>;
        };

        ckeckbox_combo {
            bindings = <&checkbox>;
            key-positions = <22 24>;
            layers = <9 10>;
        };

        para_combo {
            bindings = <&parathesis>;
            key-positions = <11 13>;
            layers = <9 10 12 13>;
        };

        arrow_combo {
            bindings = <&arrow>;
            key-positions = <1 3>;
            layers = <9 10>;
        };

        lg2_checkbox_combo {
            bindings = <&lg2_checkbox>;
            key-positions = <22 24>;
            layers = <12 13>;
        };

        lg2_arrow_combo {
            bindings = <&lg2_arrow>;
            key-positions = <1 3>;
            layers = <12 13>;
        };

        lg2_left_bracket_letter {
            bindings = <&kp LBKT>;
            key-positions = <6 7>;
            layers = <2>;
        };

        lg2_right_bracket_letter {
            bindings = <&kp RBKT>;
            key-positions = <7 8>;
            layers = <2>;
        };

        lg2_quote_letter {
            bindings = <&kp SQT>;
            key-positions = <2 1>;
            layers = <2>;
        };

        lg2_grave_letter {
            bindings = <&kp GRAVE>;
            key-positions = <2 3>;
            layers = <2>;
        };
    };

    macros {
        bt_clear_2: bt_clear_2 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&bt BT_SEL 2 &bt BT_CLR>;
            label = "BT_CLEAR_2";
        };

        bt_clear_3: bt_clear_3 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&bt BT_SEL 3 &bt BT_CLR>;
            label = "BT_CLEAR_3";
        };

        bt_clear_4: bt_clear_4 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&bt BT_SEL 4 &bt BT_CLR>;
            label = "BT_CLEAR_4";
        };

        bt_clear_0: bt_clear_0 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&bt BT_SEL 0 &bt BT_CLR>;
            label = "BT_CLEAR_0";
        };

        bt_clear_1: bt_clear_1 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&bt BT_SEL 1 &bt BT_CLR>;
            label = "BT_CLEAR_1";
        };

        cmd_space_lang1: cmd_space_lang1 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LG(SPACE) &to 0>;
            label = "CMD_SPACE_LANG1";
        };

        cmd_space_lang2: cmd_space_lang2 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LG(SPACE) &to 2>;
            label = "CMD_SPACE_LANG2";
        };

        ctrl_space_lang1: ctrl_space_lang1 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LC(SPACE) &to 0>;
            label = "CTRL_SPACE_LANG1";
        };

        ctrl_space_lang2: ctrl_space_lang2 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LC(SPACE) &to 2>;
            label = "CTRL_SPACE_LANG2";
        };

        checkbox: checkbox {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp HOME &kp MINUS &kp SPACE &kp LBKT &kp SPACE &kp RBKT &kp SPACE &kp END>;
            label = "CHECKBOX";
        };

        parathesis: parathesis {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LPAR &kp RPAR &kp LEFT>;
            label = "PARATHESIS";
        };

        arrow: arrow {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp EQUAL &kp GT>;
            label = "ARROW";
        };

        lg2_checkbox: ru_checkbox {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LG(SPACE) &checkbox &kp LG(SPACE)>;
            label = "RU_CHECKBOX";
            tap-ms = <50>;
        };

        lg2_arrow: lg2_arrow {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LG(SPACE) &arrow &kp LG(SPACE)>;
            label = "LG2_ARROW";
            tap-ms = <50>;
        };

        ml: ml {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings =
                <&macro_param_1to1 &key_on MACRO_PLACEHOLDER &layer_on 3>,
                <&macro_pause_for_release>,
                <&macro_param_1to1 &key_off MACRO_PLACEHOLDER &layer_off 3>;

            label = "ML";
            wait-ms = <0>;
            tap-ms = <0>;
        };

        lg1_symbol: lg1_symbol {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings = <&kp LS(LC(N8)) &macro_param_1to1 &ku MACRO_PLACEHOLDER &kp LC(LS(N7))>;
            label = "LG1_SYMBOL";
            tap-ms = <50>;
        };

        ku: kp_unshift {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings = <&key_off RSHFT &macro_param_1to1 &kp MACRO_PLACEHOLDER>;
            label = "KP_UNSHIFT";
            wait-ms = <0>;
            tap-ms = <0>;
        };

        in_row_below: in_row_below {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&ku END &kp LS(RET)>;
            label = "IN_ROW_BELOW";
        };

        in_row_above: in_row_above {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&ku HOME &kp LS(RET) &kp LEFT>;
            label = "IN_ROW_ABOVE";
        };

        lg2_symbol: lg2_symbol {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings = <&kp LS(LC(N7)) &macro_param_1to1 &ku MACRO_PLACEHOLDER &kp LC(LS(N8))>;
            label = "LG2_SYMBOL";
            tap-ms = <50>;
        };
    };

    behaviors {
        td_bootloader: td_bootloader {
            compatible = "zmk,behavior-tap-dance";
            label = "TD_BOOTLOADER";
            #binding-cells = <0>;
            bindings = <&none>, <&bootloader>;
        };

        bt_0: bt_0 {
            compatible = "zmk,behavior-mod-morph";
            label = "BT_0";
            bindings = <&bt BT_SEL 0>, <&bt_clear_0>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT)>;
        };

        bt_1: bt_1 {
            compatible = "zmk,behavior-mod-morph";
            label = "BT_1";
            bindings = <&bt BT_SEL 1>, <&bt_clear_1>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT)>;
        };

        bt_2: bt_2 {
            compatible = "zmk,behavior-mod-morph";
            label = "BT_2";
            bindings = <&bt BT_SEL 2>, <&bt_clear_2>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT)>;
        };

        bt_3: bt_3 {
            compatible = "zmk,behavior-mod-morph";
            label = "BT_3";
            bindings = <&bt BT_SEL 3>, <&bt_clear_3>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT)>;
        };

        bt_4: bt_4 {
            compatible = "zmk,behavior-mod-morph";
            label = "BT_4";
            bindings = <&bt BT_SEL 4>, <&bt_clear_4>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT)>;
        };

        u_caps_word: u_caps_word {
            compatible = "zmk,behavior-mod-morph";
            label = "U_CAPS_WORD";
            bindings = <&caps_word>, <&kp CAPS>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT)>;
        };

        to_extra: to_extra {
            compatible = "zmk,behavior-tap-dance";
            label = "TO_EXTRA";
            #binding-cells = <0>;
            bindings = <&none>, <&to 1>;
        };

        to_tap: to_tap {
            compatible = "zmk,behavior-tap-dance";
            label = "TO_TAP";
            #binding-cells = <0>;
            bindings = <&none>, <&to 4>;
        };

        to_base: to_base {
            compatible = "zmk,behavior-tap-dance";
            label = "TO_BASE";
            #binding-cells = <0>;
            bindings = <&none>, <&to 0>;
        };

        to_gam: to_gam {
            compatible = "zmk,behavior-tap-dance";
            label = "TO_GAM";
            #binding-cells = <0>;
            bindings = <&none>, <&to 5>;
        };

        layer_on: layer_on {
            compatible = "zmk,behavior-toggle-layer";
            label = "LAYER_ON";
            #binding-cells = <1>;
        };

        layer_off: layer_off {
            compatible = "zmk,behavior-toggle-layer";
            label = "LAYER_OFF";
            #binding-cells = <1>;
            toggle-mode = "off";
        };

        key_on: key_on {
            compatible = "zmk,behavior-key-toggle";
            label = "KEY_ON";
            #binding-cells = <1>;
        };

        key_off: key_off {
            compatible = "zmk,behavior-key-toggle";
            label = "KEY_OFF";
            #binding-cells = <1>;
            toggle-mode = "off";
        };

        hrml: hrml {
            compatible = "zmk,behavior-hold-tap";
            label = "HRML";
            bindings = <&ml>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <170>;
            flavor = "tap-preferred";
            quick-tap-ms = <100>;
        };

        mu: mt_unshift {
            compatible = "zmk,behavior-hold-tap";
            label = "MT_UNSHIFT";
            bindings = <&kp>, <&ku>;

            #binding-cells = <2>;
            tapping-term-ms = <170>;
            quick-tap-ms = <100>;
            flavor = "tap-preferred";
        };

        lu: lt_unshift {
            compatible = "zmk,behavior-hold-tap";
            label = "LT_UNSHIFT";
            bindings = <&mo>, <&ku>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
        };

        u_left: u_left {
            compatible = "zmk,behavior-mod-morph";
            label = "U_LEFT";
            bindings = <&kp LEFT>, <&kp LEFT>;

            #binding-cells = <0>;
            mods = <(MOD_RSFT)>;
        };

        u_down: u_down {
            compatible = "zmk,behavior-mod-morph";
            label = "U_DOWN";
            bindings = <&kp DOWN>, <&kp DOWN>;

            #binding-cells = <0>;
            mods = <(MOD_RSFT)>;
        };

        u_up: u_up {
            compatible = "zmk,behavior-mod-morph";
            label = "U_UP";
            bindings = <&kp UP>, <&kp UP>;

            #binding-cells = <0>;
            mods = <(MOD_RSFT)>;
        };

        u_right: u_right {
            compatible = "zmk,behavior-mod-morph";
            label = "U_RIGHT";
            bindings = <&kp RIGHT>, <&kp RIGHT>;

            #binding-cells = <0>;
            mods = <(MOD_RSFT)>;
        };

        u_home: u_home {
            compatible = "zmk,behavior-mod-morph";
            label = "U_HOME";
            bindings = <&kp HOME>, <&kp HOME>;

            #binding-cells = <0>;
            mods = <(MOD_RSFT)>;
        };

        u_end: u_end {
            compatible = "zmk,behavior-mod-morph";
            label = "U_END";
            bindings = <&kp END>, <&kp END>;

            #binding-cells = <0>;
            mods = <(MOD_RSFT)>;
        };

        u_pgdn: u_pgdn {
            compatible = "zmk,behavior-mod-morph";
            label = "U_PGDN";
            bindings = <&kp PG_DN>, <&kp PG_DN>;

            #binding-cells = <0>;
            mods = <(MOD_RSFT)>;
        };

        u_pgup: u_pgup {
            compatible = "zmk,behavior-mod-morph";
            label = "U_PGUP";
            bindings = <&kp PG_UP>, <&kp PG_UP>;

            #binding-cells = <0>;
            mods = <(MOD_RSFT)>;
        };

        lg2_caps_word: lg2_caps_word {
            compatible = "zmk,behavior-mod-morph";
            label = "LG2_CAPS_WORD";
            bindings = <&key_on RSHFT>, <&kp CAPS>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT)>;
        };

        mtlg1: mtlg1 {
            compatible = "zmk,behavior-hold-tap";
            label = "MTLG1";
            bindings = <&kp>, <&lg1_symbol>;

            #binding-cells = <2>;
            tapping-term-ms = <170>;
            quick-tap-ms = <100>;
            flavor = "tap-preferred";
        };

        lgmt_left: lgmt_left {
            compatible = "zmk,behavior-hold-tap";
            label = "LGMT_LEFT";
            bindings = <&kp>, <&u_left>;

            #binding-cells = <2>;
            tapping-term-ms = <170>;
            quick-tap-ms = <100>;
            flavor = "tap-preferred";
        };

        lgmt_down: lgmt_down {
            compatible = "zmk,behavior-hold-tap";
            label = "LGMT_DOWN";
            bindings = <&kp>, <&u_down>;

            #binding-cells = <2>;
            tapping-term-ms = <170>;
            quick-tap-ms = <100>;
            flavor = "tap-preferred";
        };

        lgmt_up: lgmt_up {
            compatible = "zmk,behavior-hold-tap";
            label = "LGMT_UP";
            bindings = <&kp>, <&u_up>;

            #binding-cells = <2>;
            tapping-term-ms = <170>;
            quick-tap-ms = <100>;
            flavor = "tap-preferred";
        };

        lgmt_right: lgmt_right {
            compatible = "zmk,behavior-hold-tap";
            label = "LGMT_RIGHT";
            bindings = <&kp>, <&u_right>;

            #binding-cells = <2>;
            tapping-term-ms = <170>;
            quick-tap-ms = <100>;
            flavor = "tap-preferred";
        };

        lgmt_pgup: lgmt_pgup {
            compatible = "zmk,behavior-hold-tap";
            label = "LGMT_PGUP";
            bindings = <&kp>, <&u_pgup>;

            #binding-cells = <2>;
            tapping-term-ms = <170>;
            quick-tap-ms = <100>;
            flavor = "tap-preferred";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base_layer {
            label = "BASE";
            bindings = <
           &kp Q       &kp W       &kp F        &kp P        &kp B        &kp J       &kp L        &kp U        &kp Y         &kp SQT
           &mt LGUI A  &mt LALT R  &mt LCTRL S  &mt LSHFT T  &kp G        &kp M       &mt LSHFT N  &mt LCTRL E  &mt LALT I    &mt LGUI O
&kp LSHFT  &lt 15 Z    &mt RALT X  &kp C        &kp D        &kp V        &kp K       &kp H        &kp COMMA    &mt RALT DOT  &lt 15 FSLH  &kp LSHFT
                                   &lu 14 ESC   &lt 7 SPACE  &lt 8 TAB    &lt 10 RET  &lt 9 BSPC   &lt 14 DEL
            >;
        };

        extra_layer {
            label = "EXTRA";
            bindings = <
        &kp Q       &kp W       &kp E        &kp R        &kp T     &kp Y   &kp U        &kp I        &kp O         &kp P
        &mt LGUI A  &mt LALT S  &mt LCTRL D  &mt LSHFT F  &kp G     &kp H   &mt LSHFT J  &mt LCTRL K  &mt LALT L    &mt LGUI SQT
&trans  &lt 15 Z    &mt RALT X  &kp C        &kp V        &kp B     &kp N   &kp M        &kp COMMA    &mt RALT DOT  &lt 15 FSLH   &trans
                                &trans       &trans       &trans    &trans  &trans       &trans
            >;
        };

        lang2_layer {
            label = "LANG2";
            bindings = <
        &kp Q         &kp W         &kp E          &kp R         &kp T        &kp Y       &kp U        &kp I          &kp O           &kp P
        &hrml LGUI A  &hrml LALT S  &hrml LCTRL D  &mt LSHFT F   &kp G        &kp H       &mt LSHFT J  &hrml LCTRL K  &hrml LALT L    &hrml LGUI SEMI
&trans  &lt 15 Z      &hrml RALT X  &kp C          &kp V         &kp B        &kp N       &kp M        &kp COMMA      &hrml RALT DOT  &lu 15 FSLH      &trans
                                    &trans         &lu 11 SPACE  &lu 8 TAB    &lu 13 RET  &lu 12 BSPC  &trans
            >;
        };

        shortcut_layer {
            label = "SHORTCUT";
            bindings = <
        &kp Q       &kp W       &kp F        &kp P        &kp B     &kp J   &kp L        &kp U        &kp Y         &kp SQT
        &mt LGUI A  &mt LALT R  &mt LCTRL S  &mt LSHFT T  &kp G     &kp M   &mt LSHFT N  &mt LCTRL E  &mt LALT I    &mt LGUI O
&trans  &lt 15 Z    &mt RALT X  &kp C        &kp D        &kp V     &kp K   &kp H        &kp COMMA    &mt RALT DOT  &lt 15 FSLH  &trans
                                &trans       &trans       &trans    &trans  &trans       &trans
            >;
        };

        tap_layer {
            label = "TAP";
            bindings = <
           &kp Q  &kp W  &kp F    &kp P      &kp B      &kp J      &kp L     &kp U      &kp Y    &kp APOS
           &kp A  &kp R  &kp S    &kp T      &kp G      &kp M      &kp N     &kp E      &kp I    &kp O
&kp LSHFT  &kp Z  &kp X  &kp C    &kp D      &kp V      &kp K      &kp H     &kp COMMA  &kp DOT  &kp FSLH  &kp LSHFT
                         &kp ESC  &kp SPACE  &kp TAB    &kp ENTER  &kp BSPC  &kp DEL
            >;
        };

        gaming_layer {
            bindings = <
          &kp TAB    &kp Q  &kp X     &kp E      &kp R    &trans   &trans     &trans    &trans     &kp TAB
          &kp LSHFT  &kp A  &kp W     &kp D      &kp F    &trans   &kp LEFT   &kp UP    &kp RIGHT  &kp RSHFT
&kp CAPS  &kp LCTRL  &kp Z  &kp S     &kp C      &kp B    &trans   &trans     &kp DOWN  &trans     &kp RCTRL  &trans
                            &kp LALT  &kp SPACE  &mo 6    &kp RET  &kp SPACE  &mo 14
            >;

            label = "GAM";
        };

        gaming_fn {
            bindings = <
       &kp ESC  &kp N7  &kp N8   &kp N9  &kp T     &kp Y  &kp U      &kp I      &kp O    &kp P
       &kp I    &kp N4  &kp N5   &kp N6  &kp G     &kp H  &kp J      &kp K      &kp L    &kp SEMI
&kp J  &kp M    &kp N1  &kp N2   &kp N3  &kp B     &kp N  &kp M      &kp COMMA  &kp DOT  &kp FSLH  &kp SQT
                        &kp RET  &kp N0  &trans    &to 0  &kp PSCRN  &mo 14
            >;

            label = "GAM_FN";
        };

        navi {
            bindings = <
        &kp DEL    &to_tap         &to_extra    &to_base     &none        &none         &kp LC(LEFT)  &in_row_below  &in_row_above  &kp LC(RIGHT)
        &kp LGUI   &kp LALT        &kp LCTRL    &kp LSHFT    &to_gam      &u_caps_word  &kp LEFT      &kp DOWN       &kp UP         &kp RIGHT
&trans  &kp LC(Z)  &mt RALT LC(X)  &kp LC(INS)  &kp LS(INS)  &kp LC(Y)    &kp INS       &kp HOME      &kp PG_DN      &kp PG_UP      &kp END        &trans
                                   &kp ESC      &kp SPACE    &kp TAB      &kp RET       &kp BSPC      &kp DEL
            >;

            label = "NAVI";
        };

        mouse {
            bindings = <
         &td_bootloader  &to_tap         &to_extra    &to_base     &none        &none      &kp C_AC_BACK   &kp LC(PG_UP)   &kp LC(PG_DN)  &kp C_AC_FORWARD
         &kp LGUI        &kp LALT        &kp LCTRL    &kp LSHFT    &to_gam      &none      &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_UP   &mmv MOVE_RIGHT
&kp DEL  &kp LC(Z)       &mt RALT LC(X)  &kp LC(INS)  &kp LS(INS)  &kp LC(Y)    &none      &msc SCRL_LEFT  &msc SCRL_DOWN  &msc SCRL_UP   &msc SCRL_RIGHT   &trans
                                         &kp ESC      &kp SPACE    &kp TAB      &mkp RCLK  &mkp LCLK       &mkp MCLK
            >;

            label = "MOUSE";
        };

        num_base {
            bindings = <
           &kp FSLH       &kp N7       &kp N8        &kp N9        &kp MINUS    &none         &kp LC(LEFT)    &in_row_below   &in_row_above   &kp LC(RIGHT)
           &mt LGUI STAR  &mt LALT N4  &mt LCTRL N5  &mt LSHFT N6  &kp PLUS     &u_caps_word  &mt LSHFT LEFT  &mt LCTRL DOWN  &mt LALT UP     &mt LGUI RIGHT
&kp EQUAL  &kp N0         &mt RALT N1  &kp N2        &kp N3        &kp DOT      &kp INS       &kp HOME        &kp PG_DN       &mt RALT PG_UP  &kp END         &trans
                                       &kp ESC       &kp SPACE     &kp RET      &kp ENTER     &kp BSPC        &kp DEL
            >;

            label = "NUM_BASE";
        };

        sym_base {
            bindings = <
        &kp EXCL       &kp LT         &kp EQUAL        &kp GT          &kp GRAVE           &kp CARET  &kp LBKT        &kp UNDER            &kp RBKT       &kp SQT
        &mt LGUI BSLH  &mt LALT LPAR  &mt LCTRL MINUS  &mt LSHFT RPAR  &kp PLUS            &kp PRCNT  &mt LSHFT LBRC  &mt LCTRL SEMICOLON  &mt LALT RBRC  &mt LGUI QMARK
&trans  &kp HASH       &mt RALT STAR  &kp COLON        &kp SLASH       &lg2_symbol HASH    &kp AT     &kp PIPE        &kp TILDE            &mt RALT AMPS  &kp DLLR        &trans
                                      &kp ESC          &kp SPACE       &kp DQT             &kp ENTER  &kp BSPC        &kp DEL
            >;

            label = "SYM_BASE";
        };

        navi_lang2 {
            label = "NAVI_LANG2";
            bindings = <
        &kp DEL    &to_tap         &to_extra    &to_base     &none        &none           &ku LC(LEFT)  &in_row_below  &in_row_above  &ku LC(RIGHT)
        &kp LGUI   &kp LALT        &kp LCTRL    &kp LSHFT    &to_gam      &lg2_caps_word  &u_left       &u_down        &u_up          &u_right
&trans  &kp LC(Z)  &mt RALT LC(X)  &kp LC(INS)  &kp LS(INS)  &kp LC(Y)    &kp INS         &u_home       &u_pgdn        &u_pgup        &u_end         &trans
                                   &ku ESC      &ku SPACE    &ku TAB      &ku RET         &kp BSPC      &kp DEL
            >;
        };

        num_lang2 {
            bindings = <
           &ku PIPE       &ku N7       &ku N8        &ku N9        &ku MINUS    &none           &ku LC(LEFT)        &in_row_below       &in_row_above      &ku LC(RIGHT)
           &mu LGUI STAR  &mu LALT N4  &mu LCTRL N5  &mu LSHFT N6  &ku PLUS     &lg2_caps_word  &lgmt_left LSHFT 0  &lgmt_down LCTRL 0  &lgmt_up LALT 0    &lgmt_right LGUI 0
&kp EQUAL  &ku N0         &mu RALT N1  &ku N2        &ku N3        &ku FSLH     &kp INS         &u_home             &u_pgdn             &lgmt_pgup RALT 0  &u_end              &trans
                                       &ku ESC       &ku SPACE     &ku RET      &ku ENTER       &kp BSPC            &kp DEL
            >;

            label = "NUM_LANG2";
        };

        sym_lang2 {
            bindings = <
        &ku EXCL          &lg1_symbol LT  &ku EQUAL        &lg1_symbol GT  &lg1_symbol GRAVE    &lg1_symbol CARET  &lg1_symbol LBRC   &ku UNDER          &lg1_symbol RBRC  &lg1_symbol SQT
        &mu LGUI BSLH     &mu LALT LPAR   &mu LCTRL MINUS  &mu LSHFT RPAR  &ku PLUS             &ku PRCNT          &mtlg1 LSHFT LBKT  &mu LCTRL DLLR     &mtlg1 LALT RBRC  &mu LGUI AMPS
&trans  &lg1_symbol HASH  &mu RALT STAR   &ku CARET        &ku PIPE        &ku HASH             &lg1_symbol AT     &ku LS(NUBS)       &lg1_symbol TILDE  &mtlg1 RALT AMPS  &lg1_symbol DLLR  &trans
                                          &ku ESC          &ku SPACE       &kp AT               &ku ENTER          &kp BSPC           &kp DEL
            >;

            label = "SYM_LANG2";
        };

        fun {
            bindings = <
                &kp F12       &kp F7       &kp F8        &kp F9        &kp PSCRN          &bt_0         &bt_1                 &bt_2             &bt_3              &bt_4
                &mt LGUI F11  &mt LALT F4  &mt LCTRL F5  &mt LSHFT F6  &kp SCROLLLOCK     &out OUT_BLE  &mt LSHFT C_VOL_DN    &mt LCTRL K_MUTE  &mt LALT C_VOL_UP  &mt LGUI C_STOP
&td_bootloader  &kp F10       &mt RALT F1  &kp F2        &kp F3        &kp PAUSE_BREAK    &out OUT_USB  &kp C_PREV            &kp C_PP          &mt RALT C_NEXT    &bt BT_CLR_ALL   &td_bootloader
                                           &kp K_APP     &kp SPACE     &kp TAB            &kp C_AL_WWW  &kp C_AL_MY_COMPUTER  &kp C_AL_CALC
            >;

            label = "FUN";
        };

        button {
            bindings = <
        &kp LC(Z)  &kp LC(X)  &kp LC(INS)  &kp LS(INS)  &kp LC(Y)    &kp LC(Y)  &kp LS(INS)  &kp LC(INS)  &kp LC(X)  &kp LC(Z)
        &kp LGUI   &kp LALT   &kp LCTRL    &kp LSHFT    &trans       &trans     &kp LSHFT    &kp LCTRL    &kp LALT   &kp LGUI
&trans  &kp LC(Z)  &kp LC(X)  &kp LC(INS)  &kp LS(INS)  &kp LC(Y)    &kp LC(Y)  &kp LS(INS)  &kp LC(INS)  &kp LC(X)  &kp LC(Z)  &trans
                              &mkp MCLK    &mkp LCLK    &mkp RCLK    &mkp RCLK  &mkp LCLK    &mkp MCLK
            >;

            label = "BUTTON";
        };
    };
};
