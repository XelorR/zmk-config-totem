//                                                        ▀▀▀▀▀     ▀▀▀▀▀          ▀▀█▀▀
//                                                        ▄▀▀▀▄  ▄  ▄▀▀▀▄  ▄  ▄▀▀▀▄  █  ▄▀▀▀▄
//                                                        █   █  █  █   █  █  █   █  █  █   █
//                                                         ▀▀▀   █   ▀▀▀   █   ▀▀▀   ▀   ▀▀▀
//                                                               █      ▄▄▄█▄▄▄    █   █  
//                                                               ▀      █  █  █     █▄█
//                                                             ▀▀▀▀▀    █  █  █      ▀
//                                                                      ▀  ▀  ▀
//
// ▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄

#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/ext_power.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

&mt {
    quick-tap-ms = <100>;
    global-quick-tap;
    flavor = "tap-preferred";
    tapping-term-ms = <170>;
};

/ {
    combos {
        compatible = "zmk,combos";

        un_tap {
            bindings = <&to 0>;
            key-positions = <0 9>;
            layers = <4>;
        };

        win_lg1 {
            bindings = <&cmd_space_lang1>;
            key-positions = <1 3>;
            layers = <0 2>;
        };

        win_lg2 {
            bindings = <&cmd_space_lang2>;
            key-positions = <6 8>;
            layers = <0 2>;
        };

        mac_lg1 {
            bindings = <&ctrl_space_lang1>;
            key-positions = <0 3>;
            layers = <0 2>;
        };

        mac_lg2 {
            bindings = <&ctrl_space_lang2>;
            key-positions = <6 9>;
            layers = <0 2>;
        };

        lg2_left_bracket_letter {
            bindings = <&kp LBKT>;
            key-positions = <6 7>;
            layers = <2>;
        };

        lg2_right_bracket_letter {
            bindings = <&kp RBKT>;
            key-positions = <7 8>;
            layers = <2>;
        };

        lg2_quote_letter {
            bindings = <&kp SQT>;
            key-positions = <2 1>;
            layers = <2>;
        };

        lg2_grave_letter {
            bindings = <&kp GRAVE>;
            key-positions = <2 3>;
            layers = <2>;
        };

        undo {
            bindings = <&kp LC(Z)>;
            key-positions = <21 22>;
            layers = <0 2>;
        };

        redo {
            bindings = <&kp LC(Y)>;
            key-positions = <21 23>;
            layers = <0 2>;
        };

        cut {
            bindings = <&kp LC(X)>;
            key-positions = <22 24>;
            layers = <0 2>;
        };

        copy {
            bindings = <&kp LC(INS)>;
            key-positions = <23 22>;
            layers = <0 2>;
        };

        paste {
            bindings = <&kp LS(INS)>;
            key-positions = <23 24>;
            layers = <0 2>;
        };

        select_all {
            bindings = <&kp LC(A)>;
            key-positions = <24 21>;
            layers = <0 2>;
        };
    };

    macros {
        cmd_space_lang1: cmd_space_lang1 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LG(SPACE) &to 0>;
            label = "CMD_SPACE_LANG1";
        };

        cmd_space_lang2: cmd_space_lang2 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LG(SPACE) &to 2>;
            label = "CMD_SPACE_LANG2";
        };

        ctrl_space_lang1: ctrl_space_lang1 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LC(SPACE) &to 0>;
            label = "CTRL_SPACE_LANG1";
        };

        ctrl_space_lang2: ctrl_space_lang2 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LC(SPACE) &to 2>;
            label = "CTRL_SPACE_LANG2";
        };

        bt_clear_2: bt_clear_2 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&bt BT_SEL 2 &bt BT_CLR>;
            label = "BT_CLEAR_2";
        };

        bt_clear_3: bt_clear_3 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&bt BT_SEL 3 &bt BT_CLR>;
            label = "BT_CLEAR_3";
        };

        bt_clear_4: bt_clear_4 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&bt BT_SEL 4 &bt BT_CLR>;
            label = "BT_CLEAR_4";
        };

        bt_clear_0: bt_clear_0 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&bt BT_SEL 0 &bt BT_CLR>;
            label = "BT_CLEAR_0";
        };

        bt_clear_1: bt_clear_1 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&bt BT_SEL 1 &bt BT_CLR>;
            label = "BT_CLEAR_1";
        };

        ml: ml {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings =
                <&macro_param_1to1 &key_on MACRO_PLACEHOLDER &layer_on 3>,
                <&macro_pause_for_release>,
                <&macro_param_1to1 &key_off MACRO_PLACEHOLDER &layer_off 3>;

            label = "ML";
            wait-ms = <0>;
            tap-ms = <0>;
        };

        ku: kp_unshift {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings = <&key_off RSHFT &macro_param_1to1 &kp MACRO_PLACEHOLDER>;
            label = "KP_UNSHIFT";
            wait-ms = <0>;
            tap-ms = <0>;
        };
    };

    behaviors {
        mu: mt_unshift {
            compatible = "zmk,behavior-hold-tap";
            label = "MT_UNSHIFT";
            bindings = <&kp>, <&ku>;

            #binding-cells = <2>;
            tapping-term-ms = <170>;
            quick-tap-ms = <100>;
            flavor = "tap-preferred";
        };

        lu: lt_unshift {
            compatible = "zmk,behavior-hold-tap";
            label = "LT_UNSHIFT";
            bindings = <&mo>, <&ku>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
        };

        td_bootloader: td_bootloader {
            compatible = "zmk,behavior-tap-dance";
            label = "TD_BOOTLOADER";
            #binding-cells = <0>;
            bindings = <&none>, <&bootloader>;
        };

        bt_0: bt_0 {
            compatible = "zmk,behavior-mod-morph";
            label = "BT_0";
            bindings = <&bt BT_SEL 0>, <&bt_clear_0>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT)>;
        };

        bt_1: bt_1 {
            compatible = "zmk,behavior-mod-morph";
            label = "BT_1";
            bindings = <&bt BT_SEL 1>, <&bt_clear_1>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT)>;
        };

        bt_2: bt_2 {
            compatible = "zmk,behavior-mod-morph";
            label = "BT_2";
            bindings = <&bt BT_SEL 2>, <&bt_clear_2>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT)>;
        };

        bt_3: bt_3 {
            compatible = "zmk,behavior-mod-morph";
            label = "BT_3";
            bindings = <&bt BT_SEL 3>, <&bt_clear_3>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT)>;
        };

        bt_4: bt_4 {
            compatible = "zmk,behavior-mod-morph";
            label = "BT_4";
            bindings = <&bt BT_SEL 4>, <&bt_clear_4>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT)>;
        };

        u_out_tog: u_out_tog {
            compatible = "zmk,behavior-mod-morph";
            label = "U_OUT_TOG";
            bindings = <&out OUT_TOG>, <&out OUT_USB>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT)>;
        };

        u_ep_tog: u_ep_tog {
            compatible = "zmk,behavior-mod-morph";
            label = "U_EP_TOG";
            bindings = <&ext_power EP_TOG>, <&ext_power EP_OFF>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT)>;
        };

        u_caps_word: u_caps_word {
            compatible = "zmk,behavior-mod-morph";
            label = "U_CAPS_WORD";
            bindings = <&caps_word>, <&kp CAPS>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT)>;
        };

        lg2_caps_word: lg2_caps_word {
            compatible = "zmk,behavior-mod-morph";
            label = "LG2_CAPS_WORD";
            bindings = <&key_on RSHFT>, <&kp CAPS>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT)>;
        };

        to_extra: to_extra {
            compatible = "zmk,behavior-tap-dance";
            label = "TO_EXTRA";
            #binding-cells = <0>;
            bindings = <&none>, <&to 1>;
        };

        to_tap: to_tap {
            compatible = "zmk,behavior-tap-dance";
            label = "TO_TAP";
            #binding-cells = <0>;
            bindings = <&none>, <&to 4>;
        };

        to_base: to_base {
            compatible = "zmk,behavior-tap-dance";
            label = "TO_BASE";
            #binding-cells = <0>;
            bindings = <&none>, <&to 0>;
        };

        to_gam: to_gam {
            compatible = "zmk,behavior-tap-dance";
            label = "TO_GAM";
            #binding-cells = <0>;
            bindings = <&none>, <&to 5>;
        };

        layer_on: layer_on {
            compatible = "zmk,behavior-toggle-layer";
            label = "LAYER_ON";
            #binding-cells = <1>;
        };

        layer_off: layer_off {
            compatible = "zmk,behavior-toggle-layer";
            label = "LAYER_OFF";
            #binding-cells = <1>;
            toggle-mode = "off";
        };

        key_on: key_on {
            compatible = "zmk,behavior-key-toggle";
            label = "KEY_ON";
            #binding-cells = <1>;
        };

        key_off: key_off {
            compatible = "zmk,behavior-key-toggle";
            label = "KEY_OFF";
            #binding-cells = <1>;
            toggle-mode = "off";
        };

        hrml: hrml {
            compatible = "zmk,behavior-hold-tap";
            label = "HRML";
            bindings = <&ml>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <170>;
            flavor = "tap-preferred";
            quick-tap-ms = <100>;
        };

        frz_nav: frz_nav {
            compatible = "zmk,behavior-tap-dance";
            label = "FRZ_NAV";
            #binding-cells = <0>;
            bindings = <&none>, <&tog 7>;
        };

        frz_mou: frz_mou {
            compatible = "zmk,behavior-tap-dance";
            label = "FRZ_MOU";
            #binding-cells = <0>;
            bindings = <&none>, <&tog 8>;
        };

        frz_med: frz_med {
            compatible = "zmk,behavior-tap-dance";
            label = "FRZ_MED";
            #binding-cells = <0>;
            bindings = <&none>, <&tog 15>;
        };

        frz_num: frz_num {
            compatible = "zmk,behavior-tap-dance";
            label = "FRZ_NUM";
            #binding-cells = <0>;
            bindings = <&none>, <&tog 9>;
        };

        frz_sym: frz_sym {
            compatible = "zmk,behavior-tap-dance";
            label = "FRZ_SYM";
            #binding-cells = <0>;
            bindings = <&none>, <&tog 10>;
        };

        frz_fun: frz_fun {
            compatible = "zmk,behavior-tap-dance";
            label = "FRZ_FUN";
            #binding-cells = <0>;
            bindings = <&none>, <&tog 16>;
        };

        frz_num2: frz_num2 {
            compatible = "zmk,behavior-tap-dance";
            label = "FRZ_NUM2";
            #binding-cells = <0>;
            bindings = <&none>, <&tog 13>;
        };

        frz_sym2: frz_sym2 {
            compatible = "zmk,behavior-tap-dance";
            label = "FRZ_SYM2";
            #binding-cells = <0>;
            bindings = <&none>, <&tog 14>;
        };

        frz_nav2: frz_nav2 {
            compatible = "zmk,behavior-tap-dance";
            label = "FRZ_NAV2";
            #binding-cells = <0>;
            bindings = <&none>, <&tog 11>;
        };

        frz_mou2: frz_mou2 {
            compatible = "zmk,behavior-tap-dance";
            label = "FRZ_MOU2";
            #binding-cells = <0>;
            bindings = <&none>, <&tog 12>;
        };

        u_left: u_left {
            compatible = "zmk,behavior-mod-morph";
            label = "U_LEFT";
            bindings = <&kp LEFT>, <&kp LEFT>;

            #binding-cells = <0>;
            mods = <(MOD_RSFT)>;
        };

        u_down: u_down {
            compatible = "zmk,behavior-mod-morph";
            label = "U_DOWN";
            bindings = <&kp DOWN>, <&kp DOWN>;

            #binding-cells = <0>;
            mods = <(MOD_RSFT)>;
        };

        u_up: u_up {
            compatible = "zmk,behavior-mod-morph";
            label = "U_UP";
            bindings = <&kp UP>, <&kp UP>;

            #binding-cells = <0>;
            mods = <(MOD_RSFT)>;
        };

        u_right: u_right {
            compatible = "zmk,behavior-mod-morph";
            label = "U_RIGHT";
            bindings = <&kp RIGHT>, <&kp RIGHT>;

            #binding-cells = <0>;
            mods = <(MOD_RSFT)>;
        };

        u_home: u_home {
            compatible = "zmk,behavior-mod-morph";
            label = "U_HOME";
            bindings = <&kp HOME>, <&kp HOME>;

            #binding-cells = <0>;
            mods = <(MOD_RSFT)>;
        };

        u_end: u_end {
            compatible = "zmk,behavior-mod-morph";
            label = "U_END";
            bindings = <&kp END>, <&kp END>;

            #binding-cells = <0>;
            mods = <(MOD_RSFT)>;
        };

        u_pgdn: u_pgdn {
            compatible = "zmk,behavior-mod-morph";
            label = "U_PGDN";
            bindings = <&kp PG_DN>, <&kp PG_DN>;

            #binding-cells = <0>;
            mods = <(MOD_RSFT)>;
        };

        u_pgup: u_pgup {
            compatible = "zmk,behavior-mod-morph";
            label = "U_PGUP";
            bindings = <&kp PG_UP>, <&kp PG_UP>;

            #binding-cells = <0>;
            mods = <(MOD_RSFT)>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base_layer {
            label = "BASE";
            bindings = <
           &kp Q       &kp W       &kp E        &kp R        &kp T        &kp Y       &kp U        &kp I        &kp O         &kp P
           &mt LGUI A  &mt LALT S  &mt LCTRL D  &mt LSHFT F  &kp G        &kp H       &mt LSHFT J  &mt LCTRL K  &mt LALT L    &mt LGUI SQT
&kp LSHFT  &lt 17 Z    &mt RALT X  &kp C        &kp V        &kp B        &kp N       &kp M        &kp COMMA    &mt RALT DOT  &lt 17 FSLH   &kp LSHFT
                                   &lu 15 ESC   &lt 7 SPACE  &lt 8 TAB    &lt 10 RET  &lt 9 BSPC   &lt 16 DEL
            >;
        };

        extra_layer {
            label = "EXTRA";
            bindings = <
        &kp Q       &kp W       &kp F        &kp P        &kp G     &kp J   &kp L        &kp U        &kp Y         &kp SQT
        &mt LGUI A  &mt LALT R  &mt LCTRL S  &mt LSHFT T  &kp D     &kp H   &mt LSHFT N  &mt LCTRL E  &mt LALT I    &mt LGUI O
&trans  &lt 17 Z    &mt RALT X  &kp C        &kp V        &kp B     &kp K   &kp M        &kp COMMA    &mt RALT DOT  &lt 17 FSLH  &trans
                                &trans       &trans       &trans    &trans  &trans       &trans
            >;
        };

        lang2_layer {
            label = "LANG2";
            bindings = <
        &kp Q         &kp W         &kp E          &kp R         &kp T         &kp Y       &kp U        &kp I          &kp O           &kp P
        &hrml LGUI A  &hrml LALT S  &hrml LCTRL D  &mt LSHFT F   &kp G         &kp H       &mt LSHFT J  &hrml LCTRL K  &hrml LALT L    &hrml LGUI SEMI
&trans  &lt 17 Z      &hrml RALT X  &kp C          &kp V         &kp B         &kp N       &kp M        &kp COMMA      &hrml RALT DOT  &lu 17 FSLH      &trans
                                    &trans         &lu 11 SPACE  &lu 12 TAB    &lu 14 RET  &lu 13 BSPC  &trans
            >;
        };

        shortcut_layer {
            label = "SHORTCUT";
            bindings = <
        &kp Q       &kp W       &kp E        &kp R        &kp T     &kp Y   &kp U        &kp I        &kp O         &kp P
        &mt LGUI A  &mt LALT S  &mt LCTRL D  &mt LSHFT F  &kp G     &kp H   &mt LSHFT J  &mt LCTRL K  &mt LALT L    &mt LGUI SQT
&trans  &lt 17 Z    &mt RALT X  &kp C        &kp V        &kp B     &kp N   &kp M        &kp COMMA    &mt RALT DOT  &lt 17 FSLH   &trans
                                &trans       &trans       &trans    &trans  &trans       &trans
            >;
        };

        tap_layer {
            label = "TAP";
            bindings = <
           &kp Q  &kp W  &kp E    &kp R      &kp T      &kp Y      &kp U     &kp I      &kp O    &kp P
           &kp A  &kp S  &kp D    &kp F      &kp G      &kp H      &kp J     &kp K      &kp L    &kp SQT
&kp LSHFT  &kp Z  &kp X  &kp C    &kp V      &kp B      &kp N      &kp M     &kp COMMA  &kp DOT  &kp FSLH  &kp LSHFT
                         &kp ESC  &kp SPACE  &kp TAB    &kp ENTER  &kp BSPC  &kp DEL
            >;
        };

        gaming_layer {
            bindings = <
          &kp TAB    &kp Q  &kp X     &kp E      &kp R    &trans      &trans     &trans    &trans     &kp TAB
          &kp LSHFT  &kp A  &kp W     &kp D      &kp F    &trans      &kp LEFT   &kp UP    &kp RIGHT  &kp RSHFT
&kp CAPS  &kp LCTRL  &kp Z  &kp S     &kp C      &kp B    &trans      &trans     &kp DOWN  &trans     &kp RCTRL  &trans
                            &kp LALT  &kp SPACE  &mo 6    &lt 15 RET  &kp SPACE  &mo 16
            >;

            label = "GAM";
        };

        gaming_fn {
            bindings = <
       &kp ESC  &kp N7  &kp N8   &kp N9  &kp T     &kp Y  &kp U      &kp I      &kp O    &kp P
       &kp I    &kp N4  &kp N5   &kp N6  &kp G     &kp H  &kp J      &kp K      &kp L    &kp SEMI
&kp J  &kp M    &kp N1  &kp N2   &kp N3  &kp B     &kp N  &kp M      &kp COMMA  &kp DOT  &kp FSLH  &kp SQT
                        &kp RET  &kp N0  &trans    &to 0  &kp PSCRN  &mo 16
            >;

            label = "GAM_FN";
        };

        navi {
            bindings = <
        &td_bootloader  &to_tap   &to_extra  &to_base   &none      &kp LC(Y)     &kp LS(INS)  &kp LC(INS)  &kp LC(X)  &kp LC(Z)
        &kp LGUI        &kp LALT  &kp LCTRL  &kp LSHFT  &to_gam    &u_caps_word  &kp LEFT     &kp DOWN     &kp UP     &kp RIGHT
&trans  &none           &kp RALT  &frz_num   &frz_nav   &none      &kp INS       &kp HOME     &kp PG_DN    &kp PG_UP  &kp END    &trans
                                  &kp ESC    &kp SPACE  &kp TAB    &kp RET       &kp BSPC     &kp DEL
            >;

            label = "NAVI";
        };

        mouse {
            bindings = <
        &td_bootloader  &to_tap   &to_extra  &to_base   &none      &kp LC(Y)  &kp LS(INS)     &kp LC(INS)     &kp LC(X)     &kp LC(Z)
        &kp LGUI        &kp LALT  &kp LCTRL  &kp LSHFT  &to_gam    &none      &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_UP  &mmv MOVE_RIGHT
&trans  &none           &kp RALT  &none      &none      &none      &none      &msc SCRL_LEFT  &msc SCRL_DOWN  &msc SCRL_UP  &msc SCRL_RIGHT  &trans
                                  &kp ESC    &kp SPACE  &kp TAB    &mkp RCLK  &mkp LCLK       &mkp MCLK
            >;

            label = "MOUSE";
        };

        num_base {
            bindings = <
           &kp FSLH  &kp N7  &kp N8   &kp N9     &kp MINUS    &none      &to_base   &to_extra  &to_tap   &td_bootloader
           &kp STAR  &kp N4  &kp N5   &kp N6     &kp PLUS     &to_gam    &kp LSHFT  &kp LCTRL  &kp LALT  &kp LGUI
&kp EQUAL  &kp N0    &kp N1  &kp N2   &kp N3     &kp DOT      &none      &frz_num   &frz_nav   &kp RALT  &none           &trans
                             &kp ESC  &kp SPACE  &kp COLON    &kp ENTER  &kp BSPC   &kp DEL
            >;

            label = "NUM_BASE";
        };

        sym_base {
            bindings = <
        &kp EXCL       &kp LT         &kp EQUAL        &kp GT          &kp GRAVE    &kp CARET  &kp LBKT        &kp UNDER       &kp RBKT       &kp SQT
        &mt LGUI BSLH  &mt LALT LPAR  &mt LCTRL MINUS  &mt LSHFT RPAR  &kp PLUS     &kp PRCNT  &mt LSHFT LBRC  &mt LCTRL SEMI  &mt LALT RBRC  &mt LGUI QMARK
&trans  &kp HASH       &kp STAR       &kp COLON        &kp FSLH        &kp AT       &kp NUBS   &kp PIPE        &kp TILDE       &kp AMPS       &kp DLLR        &trans
                                      &kp ESC          &kp SPACE       &kp DQT      &kp ENTER  &kp BSPC        &kp DEL
            >;

            label = "SYM_BASE";
        };

        navi_lang2 {
            label = "NAVI_LANG2";
            bindings = <
        &td_bootloader  &to_tap   &to_extra  &to_base   &none      &ku LC(Y)       &ku LS(INS)  &ku LC(INS)  &ku LC(X)  &ku LC(Z)
        &kp LGUI        &kp LALT  &kp LCTRL  &kp LSHFT  &to_gam    &lg2_caps_word  &u_left      &u_down      &u_up      &u_right
&trans  &none           &kp RALT  &frz_num2  &frz_nav2  &none      &kp INS         &u_home      &u_pgdn      &u_pgup    &u_end     &trans
                                  &ku ESC    &ku SPACE  &ku TAB    &ku RET         &kp BSPC     &kp DEL
            >;
        };

        mouse_lang2 {
            label = "MOUSE_LANG2";
            bindings = <
        &td_bootloader  &to_tap   &to_extra  &to_base   &none      &ku LC(Y)  &ku LS(INS)     &ku LC(INS)     &ku LC(X)     &ku LC(Z)
        &kp LGUI        &kp LALT  &kp LCTRL  &kp LSHFT  &to_gam    &none      &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_UP  &mmv MOVE_RIGHT
&trans  &none           &kp RALT  &none      &none      &none      &none      &msc SCRL_LEFT  &msc SCRL_DOWN  &msc SCRL_UP  &msc SCRL_RIGHT  &trans
                                  &ku ESC    &ku SPACE  &ku TAB    &mkp RCLK  &mkp LCLK       &mkp MCLK
            >;
        };

        num_lang2 {
            bindings = <
           &kp PIPE  &kp N7  &kp N8   &kp N9     &kp MINUS    &none      &to_base   &to_extra  &to_tap   &td_bootloader
           &kp STAR  &kp N4  &kp N5   &kp N6     &kp PLUS     &to_gam    &kp LSHFT  &kp LCTRL  &kp LALT  &kp LGUI
&kp EQUAL  &kp N0    &kp N1  &kp N2   &kp N3     &kp FSLH     &none      &frz_num2  &frz_nav2  &kp RALT  &none           &trans
                             &kp ESC  &kp SPACE  &kp CARET    &ku ENTER  &kp BSPC   &kp DEL
            >;

            label = "NUM_LANG2";
        };

        sym_lang2 {
            bindings = <
        &kp EXCL       &kp LT         &kp EQUAL        &kp GT          &kp GRAVE    &kp CARET  &kp LBKT        &kp UNDER       &kp RBKT       &kp SQT
        &mt LGUI BSLH  &mt LALT LPAR  &mt LCTRL MINUS  &mt LSHFT RPAR  &kp PLUS     &kp PRCNT  &mt LSHFT LBRC  &mt LCTRL DLLR  &mt LALT RBRC  &mt LGUI AMPS
&trans  &kp HASH       &kp STAR       &kp CARET        &kp PIPE        &kp AT       &kp NUBS   &kp LS(NUBS)    &kp TILDE       &kp AMPS       &kp DLLR       &trans
                                      &kp ESC          &kp SPACE       &kp AT       &kp ENTER  &kp BSPC        &kp DEL
            >;

            label = "SYM_LANG2";
        };

        media {
            bindings = <
        &td_bootloader  &to_tap   &to_extra  &to_base   &none      &bt_4       &bt_0         &bt_1          &bt_2             &bt_3
        &kp LGUI        &kp LALT  &kp LCTRL  &kp LSHFT  &to_gam    &u_ep_tog   &kp C_PREV    &kp C_VOL_DN   &kp C_VOL_UP      &kp C_NEXT
&trans  &none           &kp RALT  &frz_fun   &frz_med   &none      &u_out_tog  &out OUT_BLE  &kp C_AC_BACK  &kp C_AC_FORWARD  &out OUT_USB  &bt BT_CLR_ALL
                                  &kp ESC    &kp SPACE  &kp TAB    &kp C_STOP  &kp C_PP      &kp K_MUTE
            >;

            label = "MEDIA";
        };

        fun {
            bindings = <
        &kp F12  &kp F7  &kp F8     &kp F9     &kp PSCRN          &none      &to_base   &to_extra  &to_tap   &td_bootloader
        &kp F11  &kp F4  &kp F5     &kp F6     &kp SCROLLLOCK     &to_gam    &kp LSHFT  &kp LCTRL  &kp LALT  &kp LGUI
&trans  &kp F10  &kp F1  &kp F2     &kp F3     &kp PAUSE_BREAK    &none      &frz_fun   &frz_med   &kp RALT  &none           &trans
                         &kp K_APP  &kp SPACE  &kp TAB            &kp ENTER  &kp BSPC   &kp DEL
            >;

            label = "FUN";
        };

        button {
            bindings = <
        &kp LC(Z)  &kp LC(X)  &kp LC(INS)  &kp LS(INS)  &kp LC(Y)    &kp LC(Y)  &kp LS(INS)  &kp LC(INS)  &kp LC(X)  &kp LC(Z)
        &kp LGUI   &kp LALT   &kp LCTRL    &kp LSHFT    &trans       &trans     &kp LSHFT    &kp LCTRL    &kp LALT   &kp LGUI
&trans  &kp LC(Z)  &kp LC(X)  &kp LC(INS)  &kp LS(INS)  &kp LC(Y)    &kp LC(Y)  &kp LS(INS)  &kp LC(INS)  &kp LC(X)  &kp LC(Z)  &trans
                              &mkp MCLK    &mkp LCLK    &mkp RCLK    &mkp RCLK  &mkp LCLK    &mkp MCLK
            >;

            label = "BUTTON";
        };
    };
};
