//                                                        █   █  █  █   █  █  █   █  █  █   █
//                                                         ▀▀▀   █   ▀▀▀   █   ▀▀▀   ▀   ▀▀▀
//                                                               █      ▄▄▄█▄▄▄    █   █  
//                                                               ▀      █  █  █     █▄█
//                                                             ▀▀▀▀▀    █  █  █      ▀
//                                                                      ▀  ▀  ▀
//
// ▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄

#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

&mt {
    quick-tap-ms = <100>;
    global-quick-tap;
    flavor = "tap-preferred";
    tapping-term-ms = <170>;
};

/ {
    combos {
        compatible = "zmk,combos";

        lg2_left_bracket_letter {
            bindings = <&kp LBKT>;
            key-positions = <6 7>;
        };

        lg2_right_bracket_letter {
            bindings = <&kp RBKT>;
            key-positions = <7 8>;
        };
    };

    macros {
        bt_clear_2: bt_clear_2 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&bt BT_SEL 2 &bt BT_CLR>;
            label = "BT_CLEAR_2";
        };

        bt_clear_3: bt_clear_3 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&bt BT_SEL 3 &bt BT_CLR>;
            label = "BT_CLEAR_3";
        };

        bt_clear_4: bt_clear_4 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&bt BT_SEL 4 &bt BT_CLR>;
            label = "BT_CLEAR_4";
        };

        bt_clear_0: bt_clear_0 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&bt BT_SEL 0 &bt BT_CLR>;
            label = "BT_CLEAR_0";
        };

        bt_clear_1: bt_clear_1 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&bt BT_SEL 1 &bt BT_CLR>;
            label = "BT_CLEAR_1";
        };
    };

    behaviors {
        td_bootloader: td_bootloader {
            compatible = "zmk,behavior-tap-dance";
            label = "TD_BOOTLOADER";
            #binding-cells = <0>;
            bindings = <&none>, <&bootloader>;
        };

        bt_0: bt_0 {
            compatible = "zmk,behavior-mod-morph";
            label = "BT_0";
            bindings = <&bt BT_SEL 0>, <&bt_clear_0>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT)>;
        };

        bt_1: bt_1 {
            compatible = "zmk,behavior-mod-morph";
            label = "BT_1";
            bindings = <&bt BT_SEL 1>, <&bt_clear_1>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT)>;
        };

        bt_2: bt_2 {
            compatible = "zmk,behavior-mod-morph";
            label = "BT_2";
            bindings = <&bt BT_SEL 2>, <&bt_clear_2>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT)>;
        };

        bt_3: bt_3 {
            compatible = "zmk,behavior-mod-morph";
            label = "BT_3";
            bindings = <&bt BT_SEL 3>, <&bt_clear_3>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT)>;
        };

        bt_4: bt_4 {
            compatible = "zmk,behavior-mod-morph";
            label = "BT_4";
            bindings = <&bt BT_SEL 4>, <&bt_clear_4>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT)>;
        };

        u_caps_word: u_caps_word {
            compatible = "zmk,behavior-mod-morph";
            label = "U_CAPS_WORD";
            bindings = <&caps_word>, <&kp CAPS>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT)>;
        };

        to_gam: to_gam {
            compatible = "zmk,behavior-tap-dance";
            label = "TO_GAM";
            #binding-cells = <0>;
            bindings = <&none>, <&to 1>;
        };

        layer_on: layer_on {
            compatible = "zmk,behavior-toggle-layer";
            label = "LAYER_ON";
            #binding-cells = <1>;
        };

        layer_off: layer_off {
            compatible = "zmk,behavior-toggle-layer";
            label = "LAYER_OFF";
            #binding-cells = <1>;
            toggle-mode = "off";
        };

        key_on: key_on {
            compatible = "zmk,behavior-key-toggle";
            label = "KEY_ON";
            #binding-cells = <1>;
        };

        key_off: key_off {
            compatible = "zmk,behavior-key-toggle";
            label = "KEY_OFF";
            #binding-cells = <1>;
            toggle-mode = "off";
        };

        u_left: u_left {
            compatible = "zmk,behavior-mod-morph";
            label = "U_LEFT";
            bindings = <&kp LEFT>, <&kp LEFT>;

            #binding-cells = <0>;
            mods = <(MOD_RSFT)>;
        };

        u_down: u_down {
            compatible = "zmk,behavior-mod-morph";
            label = "U_DOWN";
            bindings = <&kp DOWN>, <&kp DOWN>;

            #binding-cells = <0>;
            mods = <(MOD_RSFT)>;
        };

        u_up: u_up {
            compatible = "zmk,behavior-mod-morph";
            label = "U_UP";
            bindings = <&kp UP>, <&kp UP>;

            #binding-cells = <0>;
            mods = <(MOD_RSFT)>;
        };

        u_right: u_right {
            compatible = "zmk,behavior-mod-morph";
            label = "U_RIGHT";
            bindings = <&kp RIGHT>, <&kp RIGHT>;

            #binding-cells = <0>;
            mods = <(MOD_RSFT)>;
        };

        u_home: u_home {
            compatible = "zmk,behavior-mod-morph";
            label = "U_HOME";
            bindings = <&kp HOME>, <&kp HOME>;

            #binding-cells = <0>;
            mods = <(MOD_RSFT)>;
        };

        u_end: u_end {
            compatible = "zmk,behavior-mod-morph";
            label = "U_END";
            bindings = <&kp END>, <&kp END>;

            #binding-cells = <0>;
            mods = <(MOD_RSFT)>;
        };

        u_pgdn: u_pgdn {
            compatible = "zmk,behavior-mod-morph";
            label = "U_PGDN";
            bindings = <&kp PG_DN>, <&kp PG_DN>;

            #binding-cells = <0>;
            mods = <(MOD_RSFT)>;
        };

        u_pgup: u_pgup {
            compatible = "zmk,behavior-mod-morph";
            label = "U_PGUP";
            bindings = <&kp PG_UP>, <&kp PG_UP>;

            #binding-cells = <0>;
            mods = <(MOD_RSFT)>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base_layer {
            label = "BASE";
            bindings = <
           &kp Q  &kp W  &kp E      &kp R      &kp T    &kp Y  &kp U  &kp I      &kp O      &kp P
           &kp A  &kp S  &kp D      &kp F      &kp G    &kp H  &kp J  &kp K      &kp L      &kp SEMI
&kp GRAVE  &kp Z  &kp X  &kp C      &kp V      &kp B    &kp N  &kp M  &kp COMMA  &kp COMMA  &kp FSLH  &kp SQT
                         &kp LSHFT  &kp SPACE  &mo 3    &mo 6  &mo 5  &kp LSHFT
            >;
        };

        gaming_layer {
            bindings = <
          &kp TAB    &kp Q  &kp X     &kp E      &kp R    &trans   &trans     &trans    &trans     &kp TAB
          &kp LSHFT  &kp A  &kp W     &kp D      &kp F    &trans   &kp LEFT   &kp UP    &kp RIGHT  &kp RSHFT
&kp CAPS  &kp LCTRL  &kp Z  &kp S     &kp C      &kp B    &trans   &trans     &kp DOWN  &trans     &kp RCTRL  &trans
                            &kp LALT  &kp SPACE  &mo 2    &kp RET  &kp SPACE  &mo 7
            >;

            label = "GAM";
        };

        gaming_fn {
            bindings = <
       &kp ESC  &kp N7  &kp N8   &kp N9  &kp T     &kp Y  &kp U      &kp I      &kp O    &kp P
       &kp I    &kp N4  &kp N5   &kp N6  &kp G     &kp H  &kp J      &kp K      &kp L    &kp SEMI
&kp J  &kp M    &kp N1  &kp N2   &kp N3  &kp B     &kp N  &kp M      &kp COMMA  &kp DOT  &kp FSLH  &kp SQT
                        &kp RET  &kp N0  &trans    &to 0  &kp PSCRN  &mo 7
            >;

            label = "GAM_FN";
        };

        navi {
            bindings = <
                &kp DEL   &kp LA(TAB)  &kp LC(TAB)  &kp LG(TAB)  &kp ESC    &kp ESC  &kp HOME       &kp PG_DN       &kp PG_UP       &kp END
                &sk LGUI  &sk LALT     &kp LCTRL    &sk LSHFT    &kp RET    &kp RET  &kp LEFT       &kp DOWN        &kp UP          &kp RIGHT
&td_bootloader  &to_gam   &kp LC(X)    &kp LC(INS)  &kp LS(INS)  &kp TAB    &kp TAB  &kp BSPC       &kp LS(LC(N7))  &kp LC(LS(N8))  &kp DEL    &trans
                                       &trans       &mo 4        &trans     &trans   &kp LG(SPACE)  &trans
            >;

            label = "NAVI";
        };

        mouse {
            bindings = <
        &bt_0     &bt_1      &bt_2        &bt_3        &bt_4           &kp ESC    &msc SCRL_LEFT  &msc SCRL_DOWN  &msc SCRL_UP    &msc SCRL_RIGHT
        &sk LGUI  &sk LALT   &sk LCTRL    &sk LSHFT    &out OUT_BLE    &kp RET    &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_UP    &mmv MOVE_RIGHT
&trans  &to_gam   &kp LC(X)  &kp LC(INS)  &kp LS(INS)  &out OUT_USB    &kp TAB    &kp BSPC        &kp LC(LS(N7))  &kp LC(LS(N8))  &kp DEL          &trans
                             &trans       &trans       &trans          &mkp RCLK  &mkp LCLK       &mkp MCLK
            >;

            label = "MOUSE";
        };

        num_base {
            bindings = <
         &kp LBKT   &kp N7  &kp N8  &kp N9  &kp RBKT     &kp SQT      &kp NUBS   &kp LS(NUBS)    &kp LPAR        &kp RPAR
         &kp SEMI   &kp N4  &kp N5  &kp N6  &kp EQUAL    &kp MINUS    &sk LSHFT  &sk LCTRL       &sk LALT        &sk LGUI
&kp SQT  &kp GRAVE  &kp N1  &kp N2  &kp N3  &kp BSLH     &kp LG(DOT)  &kp BSPC   &kp LC(LS(N7))  &kp LS(LC(N8))  &kp DEL   &td_bootloader
                            &trans  &kp N0  &trans       &trans       &trans     &trans
            >;

            label = "NUM_BASE";
        };

        sym_base {
            bindings = <
             &kp LEFT_BRACE  &kp AMPS  &kp STAR   &kp LPAR   &kp RBRC    &kp DQT      &kp NUBS   &kp LS(NUBS)    &kp LPAR        &kp RPAR
             &kp COLON       &kp DLLR  &kp PRCNT  &kp CARET  &kp PLUS    &kp UNDER    &sk LSHFT  &sk LCTRL       &sk LALT        &sk LGUI
&kp LS(SQT)  &kp TILDE       &kp EXCL  &kp AT     &kp HASH   &kp PIPE    &kp LG(DEL)  &kp BSPC   &kp LS(LC(N7))  &kp LC(LS(N8))  &kp DEL   &td_bootloader
                                       &trans     &trans     &trans      &trans       &trans     &trans
            >;

            label = "SYM_BASE";
        };

        fun {
            bindings = <
        &kp F12  &kp F7  &kp F8  &kp F9  &kp LG(L)          &kp SCROLLLOCK  &kp C_VOL_DN  &kp K_MUTE  &kp C_VOL_UP  &td_bootloader
        &kp F11  &kp F4  &kp F5  &kp F6  &kp PSCRN          &u_caps_word    &sk LSHFT     &sk LCTRL   &sk LALT      &sk LGUI
&trans  &kp F10  &kp F1  &kp F2  &kp F3  &kp LC(LS(ESC))    &kp K_APP       &kp C_PREV    &kp C_PP    &kp C_NEXT    &kp PAUSE_BREAK  &trans
                         &trans  &trans  &trans             &trans          &trans        &trans
            >;

            label = "FUN";
        };
    };
};
